@using CRM.WebApp.ViewModels.InventoryManagement.Product
@model EditProductViewModel

@{
    ViewData["Title"] = @Localizer["Shared.Inventory.Edit.Title"];
}

<h2 class="mb-4">@Localizer["Shared.Inventory.Edit.Title"]</h2>

<form asp-action="Edit" asp-controller="Products" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-8">

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Shared.Inventory.Fields.Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NameAr" class="form-label">@Localizer["Shared.Inventory.Fields.NameAr"]</label>
                <input asp-for="NameAr" class="form-control" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="TotalCost" class="form-label">@Localizer["Shared.Inventory.Fields.TotalCost"]</label>
                    <input asp-for="TotalCost" class="form-control" />
                    <span asp-validation-for="TotalCost" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ShippingCost" class="form-label">@Localizer["Shared.Inventory.Fields.ShippingCost"]</label>
                    <input asp-for="ShippingCost" class="form-control" />
                    <span asp-validation-for="ShippingCost" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FreightCost" class="form-label">@Localizer["Shared.Inventory.Fields.FreightCost"]</label>
                    <input asp-for="FreightCost" class="form-control" />
                    <span asp-validation-for="FreightCost" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProductTypeId" class="form-label">@Localizer["Shared.Inventory.Fields.ProductType"]</label>
                <select asp-for="ProductTypeId" asp-items="Model.ProductTypes" class="form-select">
                    <option value="">@Localizer["Shared.Inventory.Fields.SelectProductType"]</option>
                </select>
                <span asp-validation-for="ProductTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label">@Localizer["Shared.Inventory.Fields.Description"]</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

        </div>

        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">@Localizer["Shared.Inventory.Fields.CurrentImage"]</label>
                @if (!string.IsNullOrEmpty(Model.ExistingImageFile))
                {
                    <div>
                        <img src="~/uploads/@Model.ExistingImageFile" alt="@Localizer["Shared.Inventory.Fields.ProductImage"]" class="img-fluid rounded border" />
                    </div>
                }
                else
                {
                    <p class="text-muted">@Localizer["Shared.Inventory.Fields.NoImage"]</p>
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewImageFile" class="form-label">@Localizer["Shared.Inventory.Fields.UploadNewImage"]</label>
                <input asp-for="NewImageFile" type="file" class="form-control" />
                <span asp-validation-for="NewImageFile" class="text-danger"></span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">@Localizer["Shared.Inventory.Actions.SaveChanges"]</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">@Localizer["Shared.Inventory.Actions.Cancel"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
