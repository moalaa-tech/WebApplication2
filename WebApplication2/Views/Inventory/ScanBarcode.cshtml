@{
    ViewData["Title"] = @Localizer["Shared.Inventory.ScanBarcode.Title"];
}

<div class="container">
    <h1>@Localizer["Shared.Inventory.ScanBarcode.Header"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>@Localizer["Shared.Inventory.ScanBarcode.ProductLookup"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="ScanBarcode" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label for="barcode" class="form-label">@Localizer["Shared.Inventory.Fields.Barcode"]</label>
                            <input type="text" id="barcode" name="barcode" class="form-control" autofocus />
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                @Localizer["Shared.Inventory.Actions.Lookup"]
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                @Localizer["Shared.Inventory.Actions.BackToList"]
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ????? ?????? ??? ??? ???????? ??? ????? ??????
        $(document).ready(function() {
            $("#barcode").focus();
        });
    </script>
}
