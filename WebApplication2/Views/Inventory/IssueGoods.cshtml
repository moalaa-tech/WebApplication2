@using CRM.WebApp.ViewModels.InventoryManagement
@model IssueGoodsViewModel

@{
    ViewData["Title"] = @Localizer["Shared.Inventory.Issue.Title"];
}

<h1>@Localizer["Shared.Inventory.Issue.Title"]</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="IssueGoods" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ItemId" class="form-label">@Localizer["Shared.Inventory.Fields.Item"]</label>
                <input asp-for="ItemId" class="form-control" type="number" />
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WarehouseId" class="form-label">@Localizer["Shared.Inventory.Fields.Warehouse"]</label>
                <input asp-for="WarehouseId" class="form-control" type="number" />
                <span asp-validation-for="WarehouseId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">@Localizer["Shared.Inventory.Fields.Quantity"]</label>
                <input asp-for="Quantity" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reference" class="form-label">@Localizer["Shared.Inventory.Fields.Reference"]</label>
                <input asp-for="Reference" class="form-control" />
                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>

            <h4 class="mt-4 mb-3">@Localizer["Shared.Inventory.BatchInformation"]</h4>

            <div class="mb-3">
                <label asp-for="BatchId" class="form-label">@Localizer["Shared.Inventory.BatchNumber"]</label>
                <input asp-for="BatchId" class="form-control" type="number" />
                <span asp-validation-for="BatchId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Barcode" class="form-label">@Localizer["Shared.Inventory.Fields.Barcode"]</label>
                <input asp-for="Barcode" class="form-control" />
                <span asp-validation-for="Barcode" class="text-danger"></span>
            </div>

            <div class="mb-3 mt-4">
                <button type="submit" class="btn btn-danger me-2">@Localizer["Shared.Inventory.Actions.IssueGoods"]</button>
                <a asp-action="Index" class="btn btn-secondary">@Localizer["Shared.Inventory.Actions.Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
