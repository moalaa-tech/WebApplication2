@using CRM.WebApp.ViewModels.InventoryManagement
@model ReceiveGoodsViewModel

@{
    ViewData["Title"] = @Localizer["Shared.Inventory.ReceiveGoods.Title"];
}

<h1>@Localizer["Shared.Inventory.ReceiveGoods.Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="ReceiveGoods" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* ---------------------------------------- *@
            @* CORE INVENTORY FIELDS *@
            @* ---------------------------------------- *@

            <div class="mb-3">
                <label asp-for="ItemId" class="form-label">@Localizer["Shared.Inventory.Fields.Item"]</label>
                <select asp-for="ItemId" asp-items="@Model.Items" class="form-control form-select">
                    <option value="" selected>@Localizer["Shared.Inventory.SelectItem"]</option>
                </select>
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WarehouseId" class="form-label">@Localizer["Shared.Inventory.Warehouse"]</label>
                <select asp-for="WarehouseId" asp-items="@Model.Warehouses" class="form-control form-select">
                    <option value="" selected>@Localizer["Shared.Inventory.SelectWarehouse"]</option>
                </select>
                <span asp-validation-for="WarehouseId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">@Localizer["Shared.Inventory.Fields.Quantity"]</label>
                <input asp-for="Quantity" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reference" class="form-label">@Localizer["Shared.Inventory.Fields.Reference"]</label>
                <input asp-for="Reference" class="form-control" />
                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>

            @* ---------------------------------------- *@
            @* BATCH / TRACKING FIELDS *@
            @* ---------------------------------------- *@

            <h4 class="mt-4 mb-3">@Localizer["Shared.Inventory.BatchInformation.Header"]</h4>

            <div class="mb-3">
                <label asp-for="BatchNumber" class="form-label">@Localizer["Shared.Inventory.BatchNumber"]</label>
                <input asp-for="BatchNumber" class="form-control" />
                <span asp-validation-for="BatchNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ManufactureDate" class="form-label">@Localizer["Shared.Inventory.ManufactureDate"]</label>
                <input asp-for="ManufactureDate" class="form-control" type="date" />
                <span asp-validation-for="ManufactureDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExpiryDate" class="form-label">@Localizer["Shared.Inventory.ExpiryDate"]</label>
                <input asp-for="ExpiryDate" class="form-control" type="date" />
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Barcode" class="form-label">@Localizer["Shared.Inventory.Fields.Barcode"]</label>
                <input asp-for="Barcode" class="form-control" />
                <span asp-validation-for="Barcode" class="text-danger"></span>
            </div>

            <div class="mb-3 mt-4">
                <button type="submit" class="btn btn-primary me-2">
                    @Localizer["common.Submit"]
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    @Localizer["common.Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
