@using CRM.WebApp.ViewModels.AutomationStep;
@model AutomationStepViewModel;
@{
    ViewData["Title"] = "Delete Automation Step";
}
<h2>Delete Automation Step</h2>

<h4>Are you sure you want to delete this?</h4>
<dl class="row">
    <dt class="col-sm-2">Order</dt>
    <dd class="col-sm-10">@Model.Order</dd>

    <dt class="col-sm-2">Action</dt>
    <dd class="col-sm-10">@Model.Action</dd>

    <dt class="col-sm-2">Email Template</dt>
    <dd class="col-sm-10">@Model.EmailTemplateId</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
