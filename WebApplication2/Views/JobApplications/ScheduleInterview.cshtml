@using CRM.WebApp.DTOs.HumanResources.JobApplication
@model UpdateJobApplicationDto

@{
    ViewData["Title"] = "Schedule Interview";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="ScheduleInterview" asp-route-id="@Model.Id" method="post">
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Applicant</label>
                <input class="form-control" value="@Model.FullName" disabled />
            </div>
            <div class="mb-3">
                <label asp-for="InterviewDate" class="form-label"></label>
                <input asp-for="InterviewDate" class="form-control" type="date" />
                <span asp-validation-for="InterviewDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="JobPostingId" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


