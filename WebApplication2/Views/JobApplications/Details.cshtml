@using CRM.Domain.Enums.HumanResources
@using CRM.WebApp.DTOs.HumanResources.JobApplication
@model JobApplicationDto

@{
    ViewData["Title"] = "Application Details";
}

<h2>@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Applicant</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Job Title</dt>
            <dd class="col-sm-9">@Model.JobTitle</dd>

            <dt class="col-sm-3">Application Date</dt>
            <dd class="col-sm-9">@Model.ApplicationDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == ApplicationStatus.Hired ? "bg-success" : Model.Status == ApplicationStatus.Rejected ? "bg-danger" : Model.Status == ApplicationStatus.Interview ? "bg-info" : Model.Status == ApplicationStatus.UnderReview ? "bg-warning" : "bg-secondary")">
                    @Model.StatusName
                </span>
            </dd>

            <dt class="col-sm-3">Interview Date</dt>
            <dd class="col-sm-9">@(Model.InterviewDate?.ToShortDateString() ?? "N/A")</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
        </dl>

        <div class="mt-3 d-flex gap-2">
            <a asp-action="DownloadResume" asp-route-id="@Model.Id" class="btn btn-secondary">Download Resume</a>
            @if (!string.IsNullOrWhiteSpace(Model.CoverLetterPath))
            {
                <a asp-action="DownloadCoverLetter" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Download Cover Letter</a>
            }
            @if (Model.Status == ApplicationStatus.Received || Model.Status == ApplicationStatus.UnderReview)
            {
                <a asp-action="ScheduleInterview" asp-route-id="@Model.Id" class="btn btn-primary">Schedule Interview</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
    
</div>


