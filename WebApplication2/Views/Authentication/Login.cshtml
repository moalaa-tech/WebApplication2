@model CRM.WebApp.ViewModels.ApplicationUser.LoginViewModel

@{
    ViewData["Title"] = @Localizer["Auth.Title.Login", "Log in"];
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <h4>@Localizer["Auth.UseLocalAccount", "Use a local account to log in."]</h4>
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email">@Localizer["Auth.Email", "Email"]</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password">@Localizer["Auth.Password", "Password"]</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label asp-for="RememberMe">
                            <input asp-for="RememberMe" />
                            @Localizer["Auth.RememberMe", "Remember me?"]
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">@Localizer["Auth.LoginButton", "Log in"]</button>
                </div>
                <div class="form-group">
                    <p>
                        <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">@Localizer["Auth.RegisterAsNewUser", "Register as a new user"]</a>
                    </p>
                    @* <p>
                        <a id="forgot-password" asp-action="ForgotPassword">Forgot your password?</a>
                    </p> *@
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}