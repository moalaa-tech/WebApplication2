@using CRM.WebApp.ViewModels.DocumentManagement
@model DocumentViewModel

@{
    ViewData["Title"] = "Delete Document";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Delete Document
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Warning: This action cannot be undone!
                        </h5>
                        <p class="mb-0">You are about to permanently delete this document and all its associated data.</p>
                    </div>

                    <div class="document-details">
                        <h5 class="mb-3">Document Details</h5>
                        <dl class="row">
                            <dt class="col-sm-3">Title:</dt>
                            <dd class="col-sm-9">@Model.Title</dd>

                            <dt class="col-sm-3">Description:</dt>
                            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</dd>

                            <dt class="col-sm-3">File Name:</dt>
                            <dd class="col-sm-9">@Model.FileName</dd>

                            <dt class="col-sm-3">Type:</dt>
                            <dd class="col-sm-9">@Model.DocumentType</dd>

                            <dt class="col-sm-3">Size:</dt>
                            <dd class="col-sm-9">@Model.FileSizeFormatted</dd>

                            <dt class="col-sm-3">Uploaded:</dt>
                            <dd class="col-sm-9">@Model.UploadDate.ToString("yyyy-MM-dd HH:mm")</dd>

                            <dt class="col-sm-3">Uploaded By:</dt>
                            <dd class="col-sm-9">@Model.UploadedBy</dd>

                            <dt class="col-sm-3">Downloads:</dt>
                            <dd class="col-sm-9">@Model.DownloadCount</dd>

                            <dt class="col-sm-3">Status:</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-@(Model.Status == "Active" ? "success" : "warning")">
                                    @Model.Status
                                </span>
                            </dd>

                            <dt class="col-sm-3">Public:</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-@(Model.IsPublic ? "success" : "secondary")">
                                    @(Model.IsPublic ? "Yes" : "No")
                                </span>
                            </dd>
                        </dl>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <h6 class="alert-heading">
                            <i class="fas fa-shield-alt me-2"></i>
                            Security Considerations
                        </h6>
                        <ul class="mb-0 ps-3">
                            <li>This action will permanently remove the document from the system</li>
                            <li>The physical file will be deleted from the server</li>
                            <li>All version history will be lost</li>
                            <li>Any shared links will become invalid</li>
                        </ul>
                    </div>

                    <form asp-action="Delete" method="post" id="deleteForm">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="form-group mt-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="confirmDelete" required />
                                <label class="form-check-label text-danger fw-bold" for="confirmDelete">
                                    I understand that this action cannot be undone and I confirm that I want to delete this document permanently.
                                </label>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                <i class="fas fa-trash me-1"></i>Permanently Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable/disable delete button based on confirmation
            $('#confirmDelete').change(function() {
                $('#deleteButton').prop('disabled', !this.checked);
            });

            // Form submission confirmation
            $('#deleteForm').on('submit', function(e) {
                if (!confirm('Are you absolutely sure you want to delete this document? This action is permanent and cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                // Show loading state
                $('#deleteButton')
                    .prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-1"></i>Deleting...');

                return true;
            });

            // Prevent accidental navigation
            let formChanged = false;
            $('#deleteForm').on('input', function() {
                formChanged = true;
            });

            $(window).on('beforeunload', function() {
                if (formChanged) {
                    return 'You have unsaved changes. Are you sure you want to leave?';
                }
            });

            $('#deleteForm').on('submit', function() {
                $(window).off('beforeunload');
            });
        });
    </script>
}