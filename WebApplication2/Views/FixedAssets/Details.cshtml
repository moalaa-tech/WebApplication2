@using CRM.WebApp.DTOs.AssetsManagment
@model FixedAssetDto

@{
    ViewData["Title"] = "Asset Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-building"></i> @Model.Name
                    <span class="badge bg-light text-dark ms-2">@Model.AssetNumber</span>
                </h3>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Asset Number:</dt>
                            <dd class="col-sm-8"><strong>@Model.AssetNumber</strong></dd>

                            <dt class="col-sm-4">Description:</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</dd>

                            <dt class="col-sm-4">Acquisition Date:</dt>
                            <dd class="col-sm-8">@Model.AcquisitionDate.ToString("yyyy-MM-dd")</dd>

                            <dt class="col-sm-4">Parent Asset:</dt>
                            <dd class="col-sm-8">@(Model.ParentAssetName ?? "None")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Acquisition Cost:</dt>
                            <dd class="col-sm-8 fw-bold">@Model.AcquisitionCost.ToString("C")</dd>

                            <dt class="col-sm-4">Salvage Value:</dt>
                            <dd class="col-sm-8">@Model.SalvageValue.ToString("C")</dd>

                            <dt class="col-sm-4">Useful Life:</dt>
                            <dd class="col-sm-8">@Model.UsefulLife months</dd>

                            <dt class="col-sm-4">Depreciation Method:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-info">@Model.DepreciationMethodName</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-success text-white text-center">
                            <div class="card-body">
                                <h6 class="card-title">Current Book Value</h6>
                                <h4>@Model.CurrentBookValue.ToString("C")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-info text-white text-center">
                            <div class="card-body">
                                <h6 class="card-title">Total Depreciation</h6>
                                <h4>@Model.TotalDepreciation.ToString("C")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-warning text-white text-center">
                            <div class="card-body">
                                <h6 class="card-title">Remaining Life</h6>
                                <h4>@Model.RemainingLife months</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <dl class="row">
                            <dt class="col-sm-3">Status:</dt>
                            <dd class="col-sm-9">
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </dd>

                            <dt class="col-sm-3">Created:</dt>
                            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                            <dt class="col-sm-3">Last Updated:</dt>
                            <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-action="DepreciationSchedule" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="fas fa-calculator"></i> Depreciation Schedule
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-cogs"></i> Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="fas fa-edit"></i> Edit Asset
                    </a>
                    <a asp-action="DepreciationSchedule" asp-route-id="@Model.Id" class="btn btn-outline-info">
                        <i class="fas fa-calculator"></i> View Depreciation
                    </a>
                    <button class="btn btn-outline-success" onclick="calculateCurrentDepreciation()">
                        <i class="fas fa-calculator"></i> Calculate Current Depreciation
                    </button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button type="submit" class="btn btn-outline-danger"
                                onclick="return confirm('Are you sure you want to delete this asset?')">
                            <i class="fas fa-trash"></i> Delete Asset
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-line"></i> Depreciation Summary
                </h5>
            </div>
            <div class="card-body">
                <div class="progress mb-2" style="height: 20px;">
                    @{
                        var depreciationPercent = (Model.TotalDepreciation / Model.AcquisitionCost) * 100;
                    }
                    <div class="progress-bar bg-success" role="progressbar"
                         style="width: @depreciationPercent%;"
                         aria-valuenow="@depreciationPercent" aria-valuemin="0" aria-valuemax="100">
                        @depreciationPercent.ToString("F1")%
                    </div>
                </div>
                <small class="text-muted">Depreciation Progress</small>

                <div class="mt-3">
                    <canvas id="valueChart" width="300" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function calculateCurrentDepreciation() {
            fetch('@Url.Action("CalculateDepreciation", new { assetId = Model.Id, asOfDate = DateTime.Now.ToString("yyyy-MM-dd") })')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(`Current depreciation as of today: $${data.depreciation.toFixed(2)}`);
                    } else {
                        alert('Error calculating depreciation: ' + data.message);
                    }
                });
        }

        // Value chart
        const ctx = document.getElementById('valueChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Book Value', 'Depreciation'],
                datasets: [{
                    data: [@Model.CurrentBookValue, @Model.TotalDepreciation],
                    backgroundColor: ['#28a745', '#17a2b8']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}