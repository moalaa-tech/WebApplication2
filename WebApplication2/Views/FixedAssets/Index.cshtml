@using CRM.WebApp.DTOs.AssetsManagment
@model IEnumerable<FixedAssetDto>

@{
    ViewData["Title"] = Localizer["FixedAssets.Index.Title", "Fixed Assets"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Localizer["FixedAssets.Index.Header", "Fixed Assets Management"]</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> @Localizer["FixedAssets.Index.NewAsset", "New Asset"]
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Localizer["FixedAssets.Field.AssetNumber", "Asset #"]</th>
                    <th>@Localizer["FixedAssets.Field.Name", "Name"]</th>
                    <th>@Localizer["FixedAssets.Field.AcquisitionDate", "Acquisition Date"]</th>
                    <th>@Localizer["FixedAssets.Field.Cost", "Cost"]</th>
                    <th>@Localizer["FixedAssets.Field.BookValue", "Book Value"]</th>
                    <th>@Localizer["FixedAssets.Field.Depreciation", "Depreciation"]</th>
                    <th>@Localizer["FixedAssets.Field.Method", "Method"]</th>
                    <th>@Localizer["FixedAssets.Field.Status", "Status"]</th>
                    <th>@Localizer["Common.Actions", "Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model)
                {
                    <tr>
                        <td>
                            <strong>@asset.AssetNumber</strong>
                        </td>
                        <td>@asset.Name</td>
                        <td>@asset.AcquisitionDate.ToString("yyyy-MM-dd")</td>
                        <td>@asset.AcquisitionCost.ToString("C")</td>
                        <td>@asset.CurrentBookValue.ToString("C")</td>
                        <td>@asset.TotalDepreciation.ToString("C")</td>
                        <td>
                            <span class="badge bg-info">@asset.DepreciationMethodName</span>
                        </td>
                        <td>
                            <span class="badge @(asset.IsActive ? "bg-success" : "bg-secondary")">
                                @(asset.IsActive ? Localizer["Common.Active", "Active"] : Localizer["Common.Inactive", "Inactive"])
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@asset.Id" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="DepreciationSchedule" asp-route-id="@asset.Id" class="btn btn-sm btn-secondary">
                                <i class="fas fa-calculator"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@asset.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('@Localizer["FixedAssets.Index.ConfirmDelete", "Are you sure you want to delete this asset?"]')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>