@using CRM.WebApp.DTOs.AssetsManagment
@model UpdateFixedAssetDto

@{
    ViewData["Title"] = "Edit Fixed Asset";
    var parentAssets = ViewBag.ParentAssets as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var depreciationMethods = ViewBag.DepreciationMethods as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-edit"></i> Edit Fixed Asset
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Asset Number</label>
                                <input class="form-control" value="@Model.AssetNumber" disabled />
                                <small class="text-muted">Asset number cannot be changed</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="AcquisitionDate" class="form-label fw-bold"></label>
                                <input asp-for="AcquisitionDate" type="date" class="form-control" />
                                <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="AcquisitionCost" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="AcquisitionCost" class="form-control" />
                                </div>
                                <span asp-validation-for="AcquisitionCost" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="SalvageValue" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="SalvageValue" class="form-control" />
                                </div>
                                <span asp-validation-for="SalvageValue" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="UsefulLife" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <input asp-for="UsefulLife" class="form-control" />
                                    <span class="input-group-text">months</span>
                                </div>
                                <span asp-validation-for="UsefulLife" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="DepreciationMethod" class="form-label fw-bold"></label>
                                <select asp-for="DepreciationMethod" class="form-select" asp-items="depreciationMethods">
                                    <option value="">Select Method</option>
                                </select>
                                <span asp-validation-for="DepreciationMethod" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="ParentAssetId" class="form-label fw-bold">Parent Asset</label>
                                <select asp-for="ParentAssetId" class="form-select" asp-items="parentAssets">
                                    <option value="">None (Top Level)</option>
                                </select>
                                <span asp-validation-for="ParentAssetId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active Asset</label>
                        </div>
                        <small class="text-muted">Inactive assets won't appear in depreciation calculations</small>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Update Asset
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle"></i> Editing Guidelines
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h6 class="alert-heading">
                        <i class="fas fa-exclamation-triangle"></i> Important Notes
                    </h6>
                    <ul class="mb-0 ps-3">
                        <li>Asset number cannot be changed after creation</li>
                        <li>Changing depreciation method may affect existing schedules</li>
                        <li>Cost and life changes will recalculate future depreciation</li>
                        <li>Parent asset changes affect organizational hierarchy</li>
                    </ul>
                </div>

                <div class="mt-3">
                    <h6>Current Values:</h6>
                    <dl class="row small">
                        <dt class="col-sm-5">Asset ID:</dt>
                        <dd class="col-sm-7">@Model.Id</dd>

                        <dt class="col-sm-5">Created:</dt>
                        <dd class="col-sm-7">@DateTime.UtcNow.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-5">Last Updated:</dt>
                        <dd class="col-sm-7">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </dl>
                </div>

                <div class="mt-3">
                    <h6>Quick Actions:</h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <button type="button" class="btn btn-outline-warning btn-sm" onclick="resetForm()">
                            <i class="fas fa-undo"></i> Reset Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function resetForm() {
            if (confirm('Are you sure you want to reset all changes?')) {
                document.querySelector('form').reset();
            }
        }

        // Form validation
        document.querySelector('form').addEventListener('submit', function (e) {
            const cost = parseFloat(document.getElementById('AcquisitionCost').value);
            const salvage = parseFloat(document.getElementById('SalvageValue').value);

            if (salvage > cost) {
                e.preventDefault();
                alert('Salvage value cannot be greater than acquisition cost.');
                return false;
            }
        });
    </script>
}