@using CRM.WebApp.DTOs.AssetsManagment
@model IEnumerable<DepreciationScheduleDto>

@{
    ViewData["Title"] = "Depreciation Schedule";
    var assetName = ViewBag.AssetName as string;
    var assetId = ViewBag.AssetId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-calculator text-info"></i> Depreciation Schedule
        @if (!string.IsNullOrEmpty(assetName))
        {
            <span class="text-muted">- @assetName</span>
        }
    </h2>
    <div>
        <a asp-action="Details" asp-route-id="@assetId" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Asset
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-info text-white">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="card-title mb-0">Depreciation History</h5>
            </div>
            <div class="col-md-6 text-end">
                <span class="badge bg-light text-dark">@Model.Count() Entries</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th class="text-end">Depreciation Amount</th>
                            <th class="text-end">Accumulated Depreciation</th>
                            <th class="text-end">Book Value</th>
                            <th>Status</th>
                            <th>Posted Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model.OrderByDescending(s => s.ScheduleDate))
                        {
                            <tr>
                                <td>@schedule.ScheduleDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end fw-bold">@schedule.DepreciationAmount.ToString("C")</td>
                                <td class="text-end">@schedule.AccumulatedDepreciation.ToString("C")</td>
                                <td class="text-end @(schedule.BookValue < schedule.AccumulatedDepreciation ? "text-danger" : "text-success")">
                                    @schedule.BookValue.ToString("C")
                                </td>
                                <td>
                                    <span class="badge @(schedule.IsPosted ? "bg-success" : "bg-warning")">
                                        @(schedule.IsPosted ? "Posted" : "Pending")
                                    </span>
                                </td>
                                <td>@schedule.CreatedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-active">
                            <td class="fw-bold">Total</td>
                            <td class="text-end fw-bold">@Model.Sum(s => s.DepreciationAmount).ToString("C")</td>
                            <td class="text-end fw-bold">@Model.Max(s => s.AccumulatedDepreciation).ToString("C")</td>
                            <td class="text-end fw-bold">@Model.Min(s => s.BookValue).ToString("C")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-calculator fa-3x text-muted mb-3"></i>
                <h5>No Depreciation Schedule Found</h5>
                <p class="text-muted">This asset doesn't have any depreciation entries yet.</p>
                <a href="#" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Generate Schedule
                </a>
            </div>
        }
    </div>
</div>

@if (Model.Any())
{
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h6 class="card-title mb-0">Depreciation Summary</h6>
                </div>
                <div class="card-body">
                    <canvas id="depreciationChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="card-title mb-0">Value Trend</h6>
                </div>
                <div class="card-body">
                    <canvas id="valueTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model.Any())
        {
                <text>
                // Depreciation Chart
                const depCtx = document.getElementById('depreciationChart').getContext('2d');
                new Chart(depCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Posted', 'Pending'],
                        datasets: [{
                            label: 'Depreciation Amount',
                            data: [
                                @Model.Where(s => s.IsPosted).Sum(s => s.DepreciationAmount),
                                @Model.Where(s => !s.IsPosted).Sum(s => s.DepreciationAmount)
                            ],
                            backgroundColor: ['#28a745', '#ffc107']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });

                // Value Trend Chart
                const trendCtx = document.getElementById('valueTrendChart').getContext('2d');
                const schedules = @Html.Raw(Json.Serialize(Model.OrderBy(s => s.ScheduleDate)));

                new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: schedules.map(s => new Date(s.scheduleDate).toLocaleDateString()),
                        datasets: [{
                            label: 'Book Value',
                            data: schedules.map(s => s.bookValue),
                            borderColor: '#007bff',
                            tension: 0.1,
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: false
                            }
                        }
                    }
                });
                </text>
        }
    </script>
}