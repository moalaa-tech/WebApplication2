@model CRM.WebApp.ViewModels.AccountsPayable.InvoiceViewModel
@{
    ViewData["Title"] = Localizer["AccountsPayable.Delete.Title", "Delete Invoice"];
}
<h1>@Localizer["AccountsPayable.Delete.Title", "Delete Invoice"]</h1>

<h3>@Localizer["AccountsPayable.Delete.Confirm", "Are you sure you want to delete this invoice?"]</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Localizer["AccountsPayable.Field.InvoiceNumber", "Invoice #"]</dt>
        <dd class="col-sm-10">@Model.InvoiceNumber</dd>
        <dt class="col-sm-2">@Localizer["AccountsPayable.Field.Vendor", "Vendor"]</dt>
        <dd class="col-sm-10">@Model.VendorName</dd>
        <dt class="col-sm-2">@Localizer["AccountsPayable.Field.Amount", "Amount"]</dt>
        <dd class="col-sm-10">@Model.Amount.ToString("C")</dd>
    </dl>
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@Localizer["Common.Delete", "Delete"]</button>
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
    </form>
</div>