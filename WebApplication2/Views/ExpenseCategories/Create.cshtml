@using CRM.WebApp.DTOs.Accounting
@model ExpenseCategoryCreateDto

@{
    ViewData["Title"] = Localizer["Shared.ExpenseCategory.Create.Title"];
}

<h1>@Localizer["Shared.ExpenseCategory.Create.Title"]</h1>

<form asp-action="Create" class="card p-4 shadow-sm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>@Localizer["Shared.ExpenseCategory.Create.Field.Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>@Localizer["Shared.ExpenseCategory.Create.Field.NameAR"]</label>
        <input asp-for="NameAR" class="form-control" />
        <span asp-validation-for="NameAR" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["common.Save"]</button>
</form>


<div>
    <a asp-action="Index">@Localizer["common.BackToList"]</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}