@using CRM.WebApp.DTOs.Accounting
@model IEnumerable<ExpenseCategoryDto>

@{
    ViewData["Title"] = Localizer["Shared.ExpenseCategory.Index.Title", "Employees"];
}

<h1>@Localizer["Shared.ExpenseCategory.Index.Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["common.Create"]</a>
</p>

<a asp-action="Create" class="btn btn-primary mb-2">@Localizer["Shared.ExpenseCategory.Create.Title"]</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["Shared.ExpenseCategory.Field.Name"]</th>
            <th>@Localizer["Shared.ExpenseCategory.Field.NameAR"]</th>
            <th>@Localizer["common.Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.NameAR</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">@Localizer["common.Edit"]</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">@Localizer["common.Details"]</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@Localizer["common.Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-controller="Expenses" asp-action="Index">@Localizer["common.BackToList"]</a>
</div>