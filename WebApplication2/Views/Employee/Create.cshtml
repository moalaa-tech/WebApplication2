@using CRM.WebApp.DTOs.HumanResources.Employee
@model CreateEmployeeDto

@{
    ViewData["Title"] = Localizer["Shared.Employee.Create.Title", "Create Employee"];
}

<h1>@Localizer["Shared.Employee.Create.Title", "Create Employee"]</h1>

<h4>@Localizer["Shared.Employee.Create.Header", "Employee"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label">@Localizer["Shared.Employee.Field.FirstName", "First Name"]</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label">@Localizer["Shared.Employee.Field.LastName", "Last Name"]</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">@Localizer["Shared.Employee.Field.Description", "Description"]</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DepartmentId" class="control-label">@Localizer["Shared.Employee.Select.Department", "Department"]</label>
                <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId">
                    <option value="">@Localizer["Shared.Employee.Select.Department", "-- Select Department --"]</option>
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gender" class="control-label">@Localizer["Shared.Employee.Select.Gender", "Gender"]</label>
                <select asp-for="Gender" class="form-control">
                    <option value="">@Localizer["Shared.Employee.Select.Gender", "-- Select Gender --"]</option>
                    <option value="1">@Localizer["Gender.Male", "Male"]</option>
                    <option value="2">@Localizer["Gender.Female", "Female"]</option>

                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="submit" value="@Localizer["Common.Create", "Create"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@Localizer["Common.Back", "Back to List"]</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}