@model CRM.WebApp.DTOs.Setting.SettingDto

@{
    ViewData["Title"] = Localizer["Setting.Delete.Title", "Delete Setting"];
}

<h1>@Localizer["Shared.Setting.Delete.Title", "Delete Setting"]</h1>

<h3>@Localizer["Shared.Setting.Delete.Confirm", "Are you sure you want to delete this?"]</h3>
<div>
    <h4>@Localizer["Setting.Delete.Header", "Setting"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Localizer["Shared.Setting.Field.Name", "Name"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Localizer["Shared.Setting.Field.CreatedDate", "Created Date"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class="col-sm-2">
            @Localizer["Shared.Setting.Field.LastModifiedDate", "Last Modified Date"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastModifiedDate)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="@Localizer["Common.Delete", "Delete"]" class="btn btn-danger" /> |
        <a asp-action="Index">@Localizer["Common.Back", "Back to List"]</a>
    </form>
</div>