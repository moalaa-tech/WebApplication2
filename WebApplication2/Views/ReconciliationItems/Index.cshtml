@model IEnumerable<CRM.WebApp.DTOs.Banking.ReconciliationItemDto>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer Localizer

<h2>@Localizer["Shared.ReconciliationItems.Index.Title"]</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["Shared.ReconciliationItems.Field.BankTransactionId"]</th>
            <th>@Localizer["Shared.ReconciliationItems.Field.Status"]</th>
            <th>@Localizer["Shared.ReconciliationItems.Field.AdjustedAmount"]</th>
            <th>@Localizer["Shared.ReconciliationItems.Field.Notes"]</th>
            <th>@Localizer["Shared.Common.Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.BankTransactionId)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>@Html.DisplayFor(modelItem => item.AdjustedAmount)</td>
                <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@Localizer["Shared.Common.Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@Localizer["Shared.Common.Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Reconciliations" asp-action="Index" class="btn btn-secondary">@Localizer["Shared.Common.BackToList"]</a>
