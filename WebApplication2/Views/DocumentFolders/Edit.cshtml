@model CRM.WebApp.DTOs.DocumentManagement.UpdateDocumentFolderDto

@{
    ViewData["Title"] = "Edit Folder";
    var parentFolders = ViewBag.ParentFolders as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row">
    <div class="col-md-6">  
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-edit"></i> Edit Folder
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter folder name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="control-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ParentFolderId" class="control-label">Parent Folder</label>
                        <select asp-for="ParentFolderId" class="form-control" asp-items="parentFolders">
                            <option value="">-- Select Parent Folder --</option>
                        </select>
                        <span asp-validation-for="ParentFolderId" class="text-danger"></span>
                        <small class="form-text text-muted">
                            Changing the parent folder will update the folder path accordingly.
                        </small>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsSystemFolder" class="form-check-input" />
                        <label asp-for="IsSystemFolder" class="form-check-label">System Folder</label>
                        <small class="form-text text-muted">
                            System folders are protected and cannot be modified by regular users.
                        </small>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                        <small class="form-text text-muted">
                            Inactive folders won't be visible in the folder tree.
                        </small>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Update Folder
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-info-circle"></i> Folder Information
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <h6 class="alert-heading">
                        <i class="fas fa-lightbulb"></i> Editing Guidelines
                    </h6>
                    <ul class="mb-0 pl-3">
                        <li>Folder names must be unique within the same parent folder</li>
                        <li>Changing the parent folder will automatically update the folder path</li>
                        <li>System folders have special permissions and restrictions</li>
                        <li>Deactivating a folder hides it from the folder tree</li>
                    </ul>
                </div>

                <div class="mt-3">
                    <h6>Current Folder Details:</h6>
                    <dl class="row small">
                        <dt class="col-sm-4">Folder ID:</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Created:</dt>
                        <dd class="col-sm-8">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</dd>

                        <dt class="col-sm-4">Last Updated:</dt>
                        <dd class="col-sm-8">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </dl>
                </div>

                <div class="mt-3">
                    <h6>Quick Actions:</h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <button type="button" class="btn btn-outline-warning btn-sm" onclick="resetForm()">
                            <i class="fas fa-undo"></i> Reset Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Function to reset form to original values
        function resetForm() {
            if (confirm('Are you sure you want to reset all changes?')) {
                document.querySelector('form').reset();
            }
        }

        // Initialize Select2 if available for better dropdown experience
        $(document).ready(function () {
            // Initialize Select2 if the library is available
            if (typeof $.fn.select2 !== 'undefined') {
                $('#ParentFolderId').select2({
                    placeholder: 'Select a parent folder',
                    allowClear: true,
                    width: '100%'
                });
            }

            // Add confirmation for system folder checkbox
            $('#IsSystemFolder').change(function () {
                if (this.checked) {
                    if (!confirm('Warning: System folders have special permissions and restrictions. Are you sure you want to mark this as a system folder?')) {
                        this.checked = false;
                    }
                }
            });

            // Add confirmation for deactivating folder
            $('#IsActive').change(function () {
                if (!this.checked) {
                    if (!confirm('Deactivating this folder will hide it from the folder tree. Are you sure you want to deactivate this folder?')) {
                        this.checked = true;
                    }
                }
            });
        });

        // Form validation
        document.querySelector('form').addEventListener('submit', function (e) {
            const nameInput = document.getElementById('Name');
            if (nameInput.value.trim() === '') {
                e.preventDefault();
                alert('Please enter a folder name.');
                nameInput.focus();
                return false;
            }

            // Additional validation can be added here
            return true;
        });
    </script>
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 1.5rem;
    }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #e3e6f0;
        padding: 1rem 1.25rem;
    }

    .card-title {
        margin-bottom: 0;
        font-weight: 600;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .btn {
        border-radius: 0.25rem;
        margin-right: 0.5rem;
    }

    .alert {
        border-radius: 0.25rem;
        border-left: 4px solid;
    }

    .alert-info {
        border-left-color: #17a2b8;
    }

    .alert-danger {
        border-left-color: #dc3545;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    /* Select2 customization if used */
    .select2-container .select2-selection--single {
        height: 38px;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 36px;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px;
    }
</style>