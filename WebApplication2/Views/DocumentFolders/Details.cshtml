@using CRM.WebApp.DTOs.DocumentManagement
@model DocumentFolderDto

@{
    ViewData["Title"] = "Folder Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-folder text-warning"></i> @Model.Name
                </h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name:</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Path:</dt>
                    <dd class="col-sm-9">@Model.Path</dd>

                    <dt class="col-sm-3">Description:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</dd>

                    <dt class="col-sm-3">Parent Folder:</dt>
                    <dd class="col-sm-9">@(Model.ParentFolderName ?? "Root")</dd>

                    <dt class="col-sm-3">Documents:</dt>
                    <dd class="col-sm-9"><span class="badge bg-info">@Model.DocumentCount</span></dd>

                    <dt class="col-sm-3">Subfolders:</dt>
                    <dd class="col-sm-9"><span class="badge bg-secondary">@Model.SubFolderCount</span></dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>

                    <dt class="col-sm-3">Created:</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">Last Updated:</dt>
                    <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</dd>
                </dl>

                <div class="mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Quick Actions</h3>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="#" class="btn btn-success">
                        <i class="fas fa-upload"></i> Upload Document
                    </a>
                    <a asp-action="Create" asp-route-parentFolderId="@Model.Id" class="btn btn-primary">
                        <i class="fas fa-folder-plus"></i> Create Subfolder
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this folder?')">
                            <i class="fas fa-trash"></i> Delete Folder
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}