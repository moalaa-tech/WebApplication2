@using CRM.WebApp.DTOs.DocumentManagement
@model IEnumerable<DocumentFolderDto>

@{
    ViewData["Title"] = "Document Folders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Document Folders</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-folder-plus"></i> New Folder
        </a>
        <a asp-action="TreeView" class="btn btn-outline-secondary">
            <i class="fas fa-sitemap"></i> Tree View
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Path</th>
                    <th>Description</th>
                    <th>Documents</th>
                    <th>Subfolders</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var folder in Model)
                {
                    <tr>
                        <td>
                            <i class="fas fa-folder text-warning"></i>
                            <strong>@folder.Name</strong>
                        </td>
                        <td>@folder.Path</td>
                        <td>@(string.IsNullOrEmpty(folder.Description) ? "N/A" : folder.Description)</td>
                        <td>
                            <span class="badge bg-info">@folder.DocumentCount</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@folder.SubFolderCount</span>
                        </td>
                        <td>
                            <span class="badge @(folder.IsActive ? "bg-success" : "bg-secondary")">
                                @(folder.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@folder.Id" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@folder.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@folder.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this folder?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>