@using CRM.WebApp.DTOs.DocumentManagement
@model IEnumerable<DocumentFolderDto>

@{
    ViewData["Title"] = Localizer["DocumentFolders.Index.Title", "Document Folders"];
}

<h2>@Localizer["DocumentFolders.Index.Title", "Document Folders"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Common.Create", "Create New"]</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["DocumentFolders.Field.Name", "Name"]</th>
            <th>@Localizer["DocumentFolders.Field.Description", "Description"]</th>
            <th>@Localizer["DocumentFolders.Field.ParentFolder", "Parent Folder"]</th>
            <th>@Localizer["Common.Actions", "Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.ParentFolderName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Common.Edit", "Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">@Localizer["Common.Details", "Details"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>