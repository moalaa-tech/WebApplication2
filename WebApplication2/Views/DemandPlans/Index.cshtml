@using CRM.WebApp.ViewModels.SupplyChainManagement.DemandPlan
@model DemandPlanListViewModel

@{
    ViewData["Title"] = Localizer["DemandPlans.Index.Title", "Demand Plans"];
}

<h2>@Localizer["DemandPlans.Index.Title", "Demand Plans"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Common.Create", "Create New"]</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["DemandPlans.Field.PlanName", "Plan Name"]</th>
            <th>@Localizer["DemandPlans.Field.StartDate", "Start Date"]</th>
            <th>@Localizer["DemandPlans.Field.EndDate", "End Date"]</th>
            <th>@Localizer["Common.Actions", "Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Plans)
        {
            <tr>
                <td>@item.PlanName</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Common.Edit", "Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">@Localizer["Common.Details", "Details"]</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">@Localizer["Common.Delete", "Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>

