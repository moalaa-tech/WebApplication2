@using CRM.WebApp.ViewModels.SupplyChainManagement.DemandPlan
@model DemandPlanEditViewModel

<h2>@Localizer["DemandPlans.Edit.Title", "Edit Demand Plan"]</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="PlanName">@Localizer["DemandPlans.Field.PlanName", "Plan Name"]</label>
        <input asp-for="PlanName" class="form-control" />
        <span asp-validation-for="PlanName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="StartDate">@Localizer["DemandPlans.Field.StartDate", "Start Date"]</label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EndDate">@Localizer["DemandPlans.Field.EndDate", "End Date"]</label>
        <input asp-for="EndDate" class="form-control" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["Common.Save", "Save"]</button>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
</form>
