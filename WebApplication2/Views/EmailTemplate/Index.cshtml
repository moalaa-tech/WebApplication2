@using CRM.WebApp.ViewModels.EmailTemplate
@model IEnumerable<EmailTemplateViewModel>
@{
    ViewData["Title"] = Localizer["EmailTemplate.Index.Title", "Email Templates"];
}
<h2>@Localizer["EmailTemplate.Index.Title", "Email Templates"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Common.Create", "Create New"]</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["EmailTemplate.Field.Name", "Name"]</th>
            <th>@Localizer["EmailTemplate.Field.Subject", "Subject"]</th>
            <th>@Localizer["Common.Actions", "Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Subject</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Common.Edit", "Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">@Localizer["Common.Details", "Details"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>
