@using CRM.WebApp.ViewModels.EmailTemplate
@model EmailTemplateViewModel
@{
    ViewData["Title"] = Localizer["EmailTemplate.Edit.Title", "Edit Email Template"];
}
<h2>@Localizer["EmailTemplate.Edit.Title", "Edit Email Template"]</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name">@Localizer["EmailTemplate.Field.Name", "Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Subject">@Localizer["EmailTemplate.Field.Subject", "Subject"]</label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Content">@Localizer["EmailTemplate.Field.Content", "Content"]</label>
        <textarea asp-for="Content" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">@Localizer["Common.Save", "Save"]</button>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
</form>
