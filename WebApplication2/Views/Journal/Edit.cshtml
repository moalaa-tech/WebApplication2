@model CRM.WebApp.ViewModels.Accounting.JournalEntryViewModel

<h2>Edit Journal Entry</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EntryDate" class="form-label"></label>
        <input asp-for="EntryDate" class="form-control" type="date" />
        <span asp-validation-for="EntryDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Debit" class="form-label"></label>
        <input asp-for="Debit" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Debit" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Credit" class="form-label"></label>
        <input asp-for="Credit" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Credit" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Reference" class="form-label"></label>
        <input asp-for="Reference" class="form-control" />
        <span asp-validation-for="Reference" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}