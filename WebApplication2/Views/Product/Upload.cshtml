@{
    ViewData["Title"] = @Localizer["Shared.Product.Upload.Title", "Upload Products"];
}

<h1>@Localizer["Shared.Product.Upload.Title", "Upload Products"]</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Localizer["Shared.Product.Upload.Instructions", "Upload an Excel file (.xlsx) with product data"]</h5>
                <form asp-controller="Product" asp-action="Upload" enctype="multipart/form-data" method="post">
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Shared.Product.Upload.SelectFile", "Select Excel File"]</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">@Localizer["Shared.Product.Upload.Button", "Upload"]</button>
                    <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
                </form>
            </div>
        </div>
    </div>
</div>
