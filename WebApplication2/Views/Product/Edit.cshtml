@using CRM.WebApp.DTOs.InventoryManagement.Product
@model UpdateProductDto

@{
    ViewData["Title"] = @Localizer["Shared.Product.Edit.Title"];
}

<h1>@Localizer["Shared.Product.Edit.Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Shared.Product.Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NameAr" class="form-label">@Localizer["Shared.Product.NameAR"]</label>
                <input asp-for="NameAr" class="form-control" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>


            <div class="mb-3">
                <label asp-for="ProductTypeId" class="form-label">@Localizer["Shared.Product.Index.Field.AllCategories"]</label>
                <select asp-for="ProductTypeId" asp-items="@ViewBag.ProductTypes" class="form-control"></select>
            </div>



            <div class="form-group mb-3">
                <label asp-for="TotalCost" class="form-label">@Localizer["Shared.Product.TotalCost"]</label>
                <input asp-for="TotalCost" class="form-control" inputmode="decimal" />
                <span asp-validation-for="TotalCost" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShippingCost" class="form-label">@Localizer["Shared.Product.ShippingCost"]</label>
                <input asp-for="ShippingCost" inputmode="decimal" class="form-control" />
                <span asp-validation-for="ShippingCost" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FreightCost" class="form-label">@Localizer["Shared.Product.FreightCost"]</label>
                <input asp-for="FreightCost" class="form-control" inputmode="decimal" />
                <span asp-validation-for="FreightCost" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label">@Localizer["Shared.Product.Description"]</label>
                <input asp-for="Description" class="form-control" inputmode="decimal" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="@Localizer["common.Submit"]" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    @Localizer["common.BackToList"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
