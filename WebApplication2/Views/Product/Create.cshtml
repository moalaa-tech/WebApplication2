@using CRM.WebApp.DTOs.InventoryManagement.Product
@model CreateProductDto

@{ 
    ViewData["Title"] = "Create Product";
}

<h1>@Localizer["Shared.Product.Create.Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">@Localizer["Shared.Product.Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NameAr" class="control-label">@Localizer["Shared.Product.NameAr"]</label>
                <input asp-for="NameAr" class="form-control" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>@Localizer["Shared.Product.Index.Field.AllCategories"]</label>
                <select asp-for="ProductTypeId" asp-items="@ViewBag.ProductTypes" class="form-control"></select>
            </div>


            <div class="form-group">
                <label asp-for="TotalCost" class="control-label">@Localizer["Shared.Product.TotalCost"]</label>
                <input asp-for="TotalCost" class="form-control" />
                <span asp-validation-for="TotalCost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ShippingCost" class="control-label">@Localizer["Shared.Product.ShippingCost"]</label>
                <input asp-for="ShippingCost" class="form-control" />
                <span asp-validation-for="ShippingCost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FreightCost" class="control-label">@Localizer["Shared.Product.FreightCost"]</label>
                <input asp-for="FreightCost" class="form-control" />
                <span asp-validation-for="FreightCost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">@Localizer["Shared.Product.Description"]</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@Localizer["common.Submit"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@Localizer["common.BackToList"]</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}