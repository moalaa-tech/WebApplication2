@using CRM.Domain.Enums.MarketingAutomation
@model CRM.WebApp.DTOs.MarketingAutomation.SocialMediaPostDto

<h2>Edit Social Media Post</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ScheduledTime" class="form-label"></label>
        <input asp-for="ScheduledTime" class="form-control" type="datetime-local" />
        <span asp-validation-for="ScheduledTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Platform" class="form-label"></label>
        <select asp-for="Platform" class="form-select" asp-items="Html.GetEnumSelectList<SocialMediaPlatform>()"></select>
        <span asp-validation-for="Platform" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PostStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}