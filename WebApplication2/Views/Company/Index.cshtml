@using CRM.WebApp.ViewModels.Company
@model IEnumerable<CompanyViewModel>

@{
    ViewData["Title"] = @Localizer["Shared.Companies.Index.Title", "Companies"];
}

<h1>@Localizer["Shared.Companies.Index.Title", "Companies"]</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Common.Create", "Create"]</a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>@Localizer["Shared.Companies.Field.Name", "Name"]</th>
            <th>@Localizer["Shared.Companies.Field.NameAr", "NameAr"]</th>
            <th>@Localizer["Shared.Companies.Field.BusinessId", "BusinessId"]</th>
            <th>@Localizer["Shared.Companies.Field.Address", "Address"]</th>
            <th>@Localizer["Shared.Companies.Field.City", "City"]</th>
            <th>@Localizer["Shared.Companies.Field.CreationDate", "CreationDate"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.NameAr)</td>
                <td>@Html.DisplayFor(modelItem => item.BusinessId)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.City)</td>
                <td>@Html.DisplayFor(modelItem => item.CreationDate)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">@Localizer["Common.Edit", "Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">@Localizer["Common.Details", "Details"]</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@Localizer["Common.Delete", "Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>