<div class="row">
    <div class="col-md-12">
        <h2>Toaster Examples</h2>
        <button class="btn btn-primary" onclick="window.toaster.success('This is a success message!')">Success Toaster</button>
        <button class="btn btn-danger" onclick="window.toaster.error('This is an error message!')">Error Toaster</button>
        <button class="btn btn-info" onclick="window.toaster.info('This is an info message!')">Info Toaster</button>
        <button class="btn btn-warning" onclick="window.toaster.warning('This is a warning message!')">Warning Toaster</button>
        <a asp-action="ShowServerToaster" class="btn btn-secondary">Show Server Toaster</a>
    </div>
</div>

<br />

