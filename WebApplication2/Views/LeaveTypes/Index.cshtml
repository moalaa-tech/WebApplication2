@using CRM.WebApp.DTOs.HumanResources.LeaveType;
@model IEnumerable<LeaveTypeDto>

@{
    ViewData["Title"] = Localizer["Shared.LeaveTypes.Index.Title", "Leave Types"];
}

<h1>@Localizer["Shared.LeaveTypes.Index.Title", "Leave Types"]</h1>

<p>
    <a asp-action="Create">@Localizer["Shared.Common.Create", "Create New"]</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NameAr)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NameAr)
                </td>
               
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Shared.Common.Edit", "Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">@Localizer["Shared.Common.Details", "Details"]</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">@Localizer["Shared.Common.Delete", "Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>