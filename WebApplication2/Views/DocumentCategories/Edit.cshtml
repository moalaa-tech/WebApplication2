@model CRM.WebApp.DTOs.DocumentManagement.UpdateDocumentCategoryDto

@{
    ViewData["Title"] = Localizer["DocumentCategories.Edit.Title", "Edit Document Category"];
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@Localizer["DocumentCategories.Edit.Title", "Edit Document Category"]</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Name" class="control-label">@Localizer["DocumentCategories.Field.Name", "Name"]</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="control-label">@Localizer["DocumentCategories.Field.Description", "Description"]</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ParentCategoryId" class="control-label">@Localizer["DocumentCategories.Field.ParentCategory", "Parent Category"]</label>
                        <select asp-for="ParentCategoryId" class="form-control" asp-items="ViewBag.ParentCategories">
                            <option value="">@Localizer["DocumentCategories.Select.ParentCategory", "-- Select Parent Category --"]</option>
                        </select>
                        <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Order" class="control-label">@Localizer["DocumentCategories.Field.Order", "Order"]</label>
                        <input asp-for="Order" class="form-control" />
                        <span asp-validation-for="Order" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">@Localizer["DocumentCategories.Field.IsActive", "Active"]</label>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> @Localizer["Common.Save", "Update"]
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> @Localizer["Common.Back", "Back to List"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}