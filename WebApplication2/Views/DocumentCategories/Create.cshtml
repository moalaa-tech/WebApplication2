@using CRM.WebApp.DTOs.DocumentManagement
@model CreateDocumentCategoryDto

@{
    ViewData["Title"] = Localizer["DocumentCategories.Create.Title", "Create Document Category"];
}

<h2>@Localizer["DocumentCategories.Create.Title", "Create Document Category"]</h2>

<form asp-action="Create">
    <div class="row">
        <div class="col-md-6">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label">@Localizer["DocumentCategories.Field.Name", "Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

             <div class="form-group">
                <label asp-for="NameAr" class="control-label">@Localizer["DocumentCategories.Field.Name", "Name"]</label>
                <input asp-for="NameAr" class="form-control" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Description" class="control-label">@Localizer["DocumentCategories.Field.Description", "Description"]</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ParentCategoryId" class="control-label">@Localizer["DocumentCategories.Field.ParentCategory", "Parent Category"]</label>
                <select asp-for="ParentCategoryId" class="form-control" asp-items="ViewBag.ParentCategories">
                    <option value="">@Localizer["DocumentCategories.Select.ParentCategory", "-- Select Parent Category --"]</option>
                </select>
                <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Order" class="control-label">@Localizer["DocumentCategories.Field.Order", "Order"]</label>
                <input asp-for="Order" class="form-control" />
                <span asp-validation-for="Order" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">@Localizer["DocumentCategories.Field.IsActive", "Active"]</label>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">@Localizer["Common.Create", "Create"]</button>
                <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
            </div>
        </div>
    </div>
</form>