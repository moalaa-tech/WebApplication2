@using CRM.WebApp.DTOs.Notification;
@model NotificationDto

@{
    ViewData["Title"] = Localizer["Notifications.Details.Title", "Notification Details"];
}

<h1>@Localizer["Notifications.Details.Title", "Notification Details"]</h1>

<dl class="row">
    <dt class="col-sm-2">@Localizer["Notifications.Field.Message", "Message"]</dt>
    <dd class="col-sm-10">@Model.Message</dd>
    <dt class="col-sm-2">@Localizer["Notifications.Field.IsRead", "Is Read"]</dt>
    <dd class="col-sm-10">@Model.IsRead</dd>
    <dt class="col-sm-2">@Localizer["Notifications.Field.DateCreated", "Date Created"]</dt>
    <dd class="col-sm-10">@Model.DateCreated</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Common.Edit", "Edit"]</a>
<a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Back", "Back to List"]</a>