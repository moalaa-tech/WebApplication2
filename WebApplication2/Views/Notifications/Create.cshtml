@using CRM.WebApp.DTOs.Notification
@model CreateNotificationDto

@{
    ViewData["Title"] = Localizer["Notifications.Create.Title", "Create Notification"];
}

<h1>@Localizer["Notifications.Create.Title", "Create Notification"]</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Message" class="control-label">@Localizer["Notifications.Field.Message", "Message"]</label>
        <input asp-for="Message" class="form-control" />
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="@Localizer["Common.Create", "Create"]" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Back", "Back to List"]</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}