@using CRM.WebApp.DTOs.InventoryManagement
@model StockInDto
<h2>Stock In</h2>
<form asp-action="In" method="post">
    <div class="mb-3">
        <label>Product</label>
        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products"></select>
    </div>
    <div class="mb-3"><label>Quantity</label><input asp-for="Quantity" class="form-control" /></div>
    <div class="mb-3"><label>Cost</label><input asp-for="Cost" class="form-control" /></div>
    <div class="mb-3"><label>Notes</label><textarea asp-for="Notes" class="form-control"></textarea></div>
    <button class="btn btn-primary">Save</button>
</form>
