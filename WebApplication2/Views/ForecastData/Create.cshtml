@model CRM.WebApp.ViewModels.SupplyChainManagement.ForecastData.ForecastDataViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? Localizer["ForecastData.Create.Title", "Create Forecast"] : Localizer["ForecastData.Edit.Title", "Edit Forecast"];
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="card-body">
            <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @if (Model.Id != 0)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="DataType" class="form-label">@Localizer["ForecastData.Field.DataType", "Data Type"]</label>
                            <select asp-for="DataType" class="form-select"
                                    asp-items="@(new SelectList(Model.DataTypes, "Value", "Text"))">
                                <option value="">@Localizer["ForecastData.Select.DataType", "-- Select Type --"]</option>
                            </select>
                            <span asp-validation-for="DataType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DataDate" class="form-label">@Localizer["ForecastData.Field.DataDate", "Data Date"]</label>
                            <input asp-for="DataDate" class="form-control" type="date" />
                            <span asp-validation-for="DataDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Value" class="form-label">@Localizer["ForecastData.Field.Value", "Value"]</label>
                            <input asp-for="Value" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Value" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="DemandPlanId" class="form-label">@Localizer["ForecastData.Field.DemandPlan", "Demand Plan"]</label>
                            <select asp-for="DemandPlanId" class="form-select"
                                    asp-items="@(new SelectList(Model.DemandPlans, "Value", "Text"))">
                                <option value="">@Localizer["ForecastData.Select.DemandPlan", "-- Select Plan --"]</option>
                            </select>
                            <span asp-validation-for="DemandPlanId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ItemId" class="form-label">@Localizer["ForecastData.Field.Item", "Item"]</label>
                            <select asp-for="ItemId" class="form-select"
                                    asp-items="@(new SelectList(Model.Items, "Value", "Text"))">
                                <option value="">@Localizer["ForecastData.Select.Item", "-- Select Item --"]</option>
                            </select>
                            <span asp-validation-for="ItemId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">@Localizer["ForecastData.Field.Notes", "Notes"]</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">@Localizer["Common.Save", "Save"]</button>
                    <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}