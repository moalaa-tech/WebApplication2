@model CRM.WebApp.ViewModels.SupplyChainManagement.ForecastData.ForecastDataFilterViewModel

@{
    ViewData["Title"] = "Filter Forecast Data";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h2>Filter Forecast Data</h2>
        </div>
        <div class="card-body">
            <form asp-action="Filter" method="post">
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="DataType" class="form-label"></label>
                            <select asp-for="DataType" class="form-select"
                                    asp-items="@(new SelectList(Model.DataTypes, "Value", "Text"))">
                                <option value="">All Types</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="DemandPlanId" class="form-label"></label>
                            <select asp-for="DemandPlanId" class="form-select"
                                    asp-items="@(new SelectList(Model.DemandPlans, "Value", "Text"))">
                                <option value="">All Plans</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                    <a asp-action="Index" class="btn btn-secondary">Reset</a>
                </div>
            </form>

            @if (Model.Results != null && Model.Results.Any())
            {
                <div class="mt-4">
                    <h3>Results</h3>
                    <div class="table-responsive">
                        <partial name="_ForecastDataTable" model="Model.Results" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>