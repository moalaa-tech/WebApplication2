@model CRM.WebApp.DTOs.HumanResources.JobPosting.JobPostingDto

@{
    ViewData["Title"] = "Job Posting Details";
}

<h2>@ViewData["Title"]</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Requirements</dt>
        <dd class="col-sm-10">@Model.Requirements</dd>
        <dt class="col-sm-2">Posting Date</dt>
        <dd class="col-sm-10">@Model.PostingDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Closing Date</dt>
        <dd class="col-sm-10">@Model.ClosingDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">@Model.IsActive</dd>
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.DepartmentName</dd>
        <dt class="col-sm-2">Applications</dt>
        <dd class="col-sm-10">@Model.ApplicationCount</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
