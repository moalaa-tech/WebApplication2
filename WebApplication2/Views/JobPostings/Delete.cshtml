@model CRM.WebApp.DTOs.HumanResources.JobPosting.JobPostingDto

@{
    ViewData["Title"] = "Delete Job Posting";
}

<h2>@ViewData["Title"]</h2>
<h3>Are you sure you want to delete this job posting?</h3>
<div>
    <h4>@Model.Title</h4>
    <p>@Model.Description</p>
    <dl class="row">
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.DepartmentName</dd>
        <dt class="col-sm-2">Posting Date</dt>
        <dd class="col-sm-10">@Model.PostingDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Closing Date</dt>
        <dd class="col-sm-10">@Model.ClosingDate.ToShortDateString()</dd>
    </dl>
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
