@using CRM.WebApp.ViewModels.SalesManagement
@model QuoteListViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Shared.Quotes.Index.Title"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Shared.Quotes.Index.Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Shared.Common.Create"]</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input asp-for="Filter.SearchTerm" class="form-control" placeholder="@Localizer["Shared.Common.Search"]">
            </div>
            <div class="col-md-3">
                <input asp-for="Filter.FromDate" type="date" class="form-control" placeholder="@Localizer["Shared.Common.FromDate"]">
            </div>
            <div class="col-md-3">
                <input asp-for="Filter.ToDate" type="date" class="form-control" placeholder="@Localizer["Shared.Common.ToDate"]">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">@Localizer["Shared.Common.Filter"]</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Localizer["Shared.Quotes.Field.QuoteNumber"]</th>
                <th>@Localizer["Shared.Quotes.Field.IssueDate"]</th>
                <th>@Localizer["Shared.Quotes.Field.ExpiryDate"]</th>
                <th>@Localizer["Shared.Quotes.Field.TotalAmount"]</th>
                <th>@Localizer["Shared.Common.Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Quotes)
            {
                <tr>
                    <td>@item.QuoteNumber</td>
                    <td>@item.IssueDate.ToShortDateString()</td>
                    <td>@item.ExpiryDate.ToShortDateString()</td>
                    <td>@item.TotalAmount.ToString("C")</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">@Localizer["Shared.Common.Details"]</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">@Localizer["Shared.Common.Edit"]</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@Localizer["Shared.Common.Delete"]</a>
                            <a asp-action="GeneratePdf" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">@Localizer["Shared.Common.PDF"]</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PagingInfo.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchTerm="@Model.Filter.SearchTerm"
                   asp-route-fromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")">@i</a>
            </li>
        }
    </ul>
</nav>