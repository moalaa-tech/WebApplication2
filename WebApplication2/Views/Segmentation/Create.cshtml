@model CRM.WebApp.ViewModels.MarketingAutomation.Segment.SegmentCreateViewModel

@{
    ViewData["Title"] = "Create Segment";
}

<h1>Create Segment</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Criteria" class="control-label"></label>
                <textarea asp-for="Criteria" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Criteria" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SegmentType" class="control-label"></label>
                <select asp-for="SegmentType" class="form-control">
                    <option value="Demographic">Demographic</option>
                    <option value="Geographic">Geographic</option>
                    <option value="Behavioral">Behavioral</option>
                    <option value="Psychographic">Psychographic</option>
                </select>
                <span asp-validation-for="SegmentType" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input class="form-check-input" asp-for="IsActive" />
                <label class="form-check-label" asp-for="IsActive"></label>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>