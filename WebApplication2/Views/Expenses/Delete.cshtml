@using CRM.WebApp.DTOs.Accounting
@model ExpenseDto

@{
    ViewData["Title"] = Localizer["Shared.Expenses.Delete.Title", "Employees"];
}

<h1>@Localizer["Shared.Expenses.Delete.Title", "Employees"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["common.Create"]</a>
</p>



<h4>Are you sure you want to delete this?</h4>
<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <p><strong>@Model.Title</strong> - @Model.Amount</p>
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>



<div>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["common.BackToList"]</a>
</div>