@using CRM.Domain.Enums
@using CRM.WebApp.ViewModels.SalesManagement
@model ActivityViewModel

@{
    ViewData["Title"] = "Activity Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Activity Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Activity Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.TypeName</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.Status == ActivityStatus.Completed ? "success" :
                                                            Model.Status == ActivityStatus.InProgress ? "primary" :
                                                            Model.Status == ActivityStatus.Cancelled ? "secondary" :
                                                            Model.Status == ActivityStatus.Deferred ? "warning" : "danger")">
                    @Model.StatusName
                </span>
                @if (Model.IsOverdue)
                {
                    <span class="badge bg-danger ms-2">Overdue</span>
                }
            </dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@Model.DueDate.ToString("g")</dd>

            <dt class="col-sm-3">Completed Date</dt>
            <dd class="col-sm-9">@(Model.CompletedDate?.ToString("g") ?? "Not completed")</dd>

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">@Model.OwnerUserName</dd>

            @if (Model.LeadId.HasValue)
            {
                <dt class="col-sm-3">Related Lead</dt>
                <dd class="col-sm-9">
                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.LeadName</a>
                </dd>
            }

            @if (Model.OpportunityId.HasValue)
            {
                <dt class="col-sm-3">Related Opportunity</dt>
                <dd class="col-sm-9">
                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId">@Model.OpportunityName</a>
                </dd>
            }

            @if (Model.DealId.HasValue)
            {
                <dt class="col-sm-3">Related Deal</dt>
                <dd class="col-sm-9">
                    <a asp-controller="Deals" asp-action="Details" asp-route-id="@Model.DealId">@Model.DealName</a>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Description</h5>
    </div>
    <div class="card-body">
        @Html.Raw(Model.Description?.Replace("\n", "<br />"))
    </div>
</div>