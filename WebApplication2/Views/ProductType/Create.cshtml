@using CRM.WebApp.DTOs.InventoryManagement.ProductType
@model CreateProductTypeDto

@{
    ViewData["Title"] = "Create Product Type";
}

<h2>Create Product Type</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NameAR" class="form-label"></label>
        <input asp-for="NameAR" class="form-control" />
        <span asp-validation-for="NameAR" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
