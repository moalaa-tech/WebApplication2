@model CRM.WebApp.DTOs.HumanResources.Payroll.CreatePayrollDto

@{
    ViewData["Title"] = "Process Payroll";
}

<div class="container">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form id="processPayrollForm" method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="EmployeeId" class="control-label">Employee</label>
                    <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
                        <option value="">Select Employee</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="BasicSalary" class="control-label"></label>
                    <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Allowances" class="control-label"></label>
                    <input asp-for="Allowances" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="Allowances" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Deductions" class="control-label"></label>
                    <input asp-for="Deductions" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="Deductions" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="TaxAmount" class="control-label"></label>
                    <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="TaxAmount" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PayPeriodStart" class="control-label">Pay Period Start</label>
                    <input asp-for="PayPeriodStart" class="form-control" type="date" required />
                    <span asp-validation-for="PayPeriodStart" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PayPeriodEnd" class="control-label">Pay Period End</label>
                    <input asp-for="PayPeriodEnd" class="form-control" type="date" required />
                    <span asp-validation-for="PayPeriodEnd" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PaymentMethod" class="control-label">Payment Method</label>
                    <select asp-for="PaymentMethod" class="form-select" required>
                        <option value="">Select Payment Method</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="Check">Check</option>
                        <option value="Cash">Cash</option>
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PaymentDate" class="control-label">Payment Date</label>
                    <input asp-for="PaymentDate" class="form-control" type="date" required />
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col">
                <button type="submit" class="btn btn-primary">Process Payroll</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            // Calculate Net Salary when any amount field changes
            $('#processPayrollForm input[type="number"]').on('change', function() {
                var basicSalary = parseFloat($('#BasicSalary').val()) || 0;
                var allowances = parseFloat($('#Allowances').val()) || 0;
                var deductions = parseFloat($('#Deductions').val()) || 0;
                var taxAmount = parseFloat($('#TaxAmount').val()) || 0;
                
                var netSalary = basicSalary + allowances - deductions - taxAmount;
                $('#NetSalary').val(netSalary.toFixed(2));
            });
        });
    </script>
}
