@model CRM.WebApp.DTOs.Project.UpdateTimeEntryDto

<h2>Edit Time Entry</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EntryDate" class="form-label"></label>
        <input asp-for="EntryDate" class="form-control" type="date" />
        <span asp-validation-for="EntryDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PhaseStartDate" class="form-label"></label>
        <input asp-for="PhaseStartDate" class="form-control" type="date" />
        <span asp-validation-for="PhaseStartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PhaseEndDate" class="form-label"></label>
        <input asp-for="PhaseEndDate" class="form-control" type="date" />
        <span asp-validation-for="PhaseEndDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}