@model IEnumerable<CRM.WebApp.ViewModels.SupplyChainManagement.Purchase.PurchaseOrderViewModel>

@{
    ViewData["Title"] = Localizer["PurchaseOrders.Index.Title", "Purchase Orders"];
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@Localizer["PurchaseOrders.Index.Title", "Purchase Orders"]</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> @Localizer["PurchaseOrders.Index.NewPurchaseOrder", "New Purchase Order"]
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.First().PONumber)</th>
                        <th>@Html.DisplayNameFor(m => m.First().OrderDate)</th>
                        <th>@Html.DisplayNameFor(m => m.First().SupplierName)</th>
                        <th>@Html.DisplayNameFor(m => m.First().TotalAmount)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Status)</th>
                        <th>@Localizer["Common.Actions", "Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var po in Model)
                {
                    <tr>
                        <td>@po.PONumber</td>
                        <td>@po.OrderDate.ToShortDateString()</td>
                        <td>@po.SupplierName</td>
                        <td>@po.TotalAmount.ToString("C")</td>
                        <td>@po.Status</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-info">@Localizer["Common.Details", "Details"]</a>
                            <a asp-action="Edit" asp-route-id="@po.Id" class="btn btn-sm btn-warning">@Localizer["Common.Edit", "Edit"]</a>
                            <a asp-action="Delete" asp-route-id="@po.Id" class="btn btn-sm btn-danger">@Localizer["Common.Delete", "Delete"]</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>