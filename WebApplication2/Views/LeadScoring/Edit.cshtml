@model CRM.WebApp.ViewModels.MarketingAutomation.LeadScore.LeadScoreEditViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">@Localizer["LeadScore.Edit.Title"]</h3>
    </div>

    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="LeadScoreUpdateDto.Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="LeadScoreUpdateDto.Name" class="form-label fw-bold"></label>
                <input asp-for="LeadScoreUpdateDto.Name" class="form-control" />
                <span asp-validation-for="LeadScoreUpdateDto.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LeadScoreUpdateDto.Description" class="form-label fw-bold"></label>
                <textarea asp-for="LeadScoreUpdateDto.Description" class="form-control"></textarea>
                <span asp-validation-for="LeadScoreUpdateDto.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LeadScoreUpdateDto.Score" class="form-label fw-bold"></label>
                <input asp-for="LeadScoreUpdateDto.Score" class="form-control" type="number" min="0" max="100" />
                <span asp-validation-for="LeadScoreUpdateDto.Score" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LeadScoreUpdateDto.ScoreType" class="form-label fw-bold"></label>
                <input asp-for="LeadScoreUpdateDto.ScoreType" class="form-control" />
                <span asp-validation-for="LeadScoreUpdateDto.ScoreType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LeadScoreUpdateDto.Criteria" class="form-label fw-bold"></label>
                <input asp-for="LeadScoreUpdateDto.Criteria" class="form-control" />
                <span asp-validation-for="LeadScoreUpdateDto.Criteria" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="LeadScoreUpdateDto.IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="LeadScoreUpdateDto.IsActive" class="form-check-label fw-bold"></label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Form.SaveChanges"]</button>
                <a asp-action="Index" class="btn btn-secondary">@Localizer["Form.BackToList"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
