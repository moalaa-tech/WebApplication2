@model CRM.WebApp.ViewModels.MarketingAutomation.LeadScore.LeadScoreDetailsViewModel

<h2>@Localizer["LeadScoring.Delete.Title"]</h2>

<div class="alert alert-danger mt-3">
    <h4>@Localizer["LeadScoring.Delete.ConfirmMessage"]</h4>
</div>

<dl class="row mt-4 border rounded p-3 bg-light">
    <dt class="col-sm-4 fw-bold">@Localizer["LeadScoring.Field.Name"]</dt>
    <dd class="col-sm-8">@Model.LeadScore.Name</dd>

    <dt class="col-sm-4 fw-bold">@Localizer["LeadScoring.Field.Description"]</dt>
    <dd class="col-sm-8">@Model.LeadScore.Description</dd>

    <dt class="col-sm-4 fw-bold">@Localizer["LeadScoring.Field.Score"]</dt>
    <dd class="col-sm-8">@Model.LeadScore.Score</dd>

    <dt class="col-sm-4 fw-bold">@Localizer["LeadScoring.Field.ScoreType"]</dt>
    <dd class="col-sm-8">@Model.LeadScore.ScoreType</dd>

    <dt class="col-sm-4 fw-bold">@Localizer["LeadScoring.Field.IsActive"]</dt>
    <dd class="col-sm-8">@Model.LeadScore.IsActive</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">
    <input type="hidden" asp-for="LeadScore.Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">
            @Localizer["Form.Delete"]
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            @Localizer["Form.Cancel"]
        </a>
    </div>
</form>
