@using CRM.WebApp.ViewModels.SupplyChainManagement
@using CRM.WebApp.ViewModels.SupplyChainManagement.Supplier
@model SupplierViewModel

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3>Delete Supplier</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h5>Are you sure you want to delete this supplier?</h5>
                    <p class="mb-0">This action cannot be undone.</p>
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Code</dt>
                    <dd class="col-sm-9">@Model.Code</dd>

                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Contact Person</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.ContactPerson) ? "N/A" : Model.ContactPerson)</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>