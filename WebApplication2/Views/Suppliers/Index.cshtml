@using CRM.WebApp.ViewModels.SupplyChainManagement
@using CRM.WebApp.ViewModels.SupplyChainManagement.Supplier
@model IEnumerable<SupplierViewModel>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck-loading me-2"></i>Suppliers</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New
    </a>
</div>

<div class="card">
    <div class="card-header bg-light">
        <div class="row">
            <div class="col-md-6">
                <h5 class="mb-0">Supplier List</h5>
            </div>
            <div class="col-md-6 text-end">
                <div class="input-group">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search suppliers..." />
                    <button class="btn btn-outline-secondary" type="button" id="searchButton">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No suppliers found. <a asp-action="Create">Create the first supplier</a>.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Contact Person</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Code</strong>
                                </td>
                                <td>@item.Name</td>
                                <td>@(string.IsNullOrEmpty(item.ContactPerson) ? "N/A" : item.ContactPerson)</td>
                                <td>@(string.IsNullOrEmpty(item.Phone) ? "N/A" : item.Phone)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <a href="mailto:@item.Email">@item.Email</a>
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="card-footer">
        <small class="text-muted">Total Suppliers: @Model.Count()</small>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Simple search functionality
            $('#searchButton').click(function () {
                const searchText = $('#searchInput').val().toLowerCase();
                $('tbody tr').each(function () {
                    const rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(searchText));
                });
            });

            $('#searchInput').on('keyup', function () {
                $('#searchButton').click();
            });
        });
    </script>
}