@using CRM.Domain.IdentityEntity
@model ApplicationRole
@{ 
    ViewData["Title"] = @Localizer["Shared.Role.Create.Title", "Create Role"];
}

<h1>@Localizer["Shared.Role.Create.Title", "Create Role"]</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">


            <div class="form-group">
                <label asp-for="Name" class="control-label">@Localizer["Shared.Role.Field.Name", "Create Role"]</label>
                <input type="text" asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="NameAR" class="control-label">@Localizer["Shared.Role.Field.Name", "Create Role"]</label>
                <input type="text" asp-for="NameAR" class="form-control" />
                <span asp-validation-for="NameAR" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="@Localizer["common.Submit"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@Localizer["common.BackToList"]</a>
</div>
