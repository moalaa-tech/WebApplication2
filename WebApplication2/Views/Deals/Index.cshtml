@using CRM.WebApp.DTOs.Deal
@model IEnumerable<DealDto>

<h1>@Localizer["Shared.Deals.Index.Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Shared.Common.Create"]</a>
</p>
<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>@Localizer["Shared.Deals.Field.Name"]</th>
            <th>@Localizer["Shared.Deals.Field.Account"]</th>
            <th>@Localizer["Shared.Deals.Field.DealOwner"]</th>
            <th>@Localizer["Shared.Deals.Field.Amount"]</th>
            <th>@Localizer["Shared.Deals.Field.ClosingDate"]</th>
            <th>@Localizer["Shared.Deals.Field.Status"]</th>
            <th>@Localizer["Shared.Common.Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.AccountName)</td>
                <td>@Html.DisplayFor(modelItem => item.DealOwner)</td>
                <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                <td>@Html.DisplayFor(modelItem => item.ClosingDate)</td>
                <td>@(item.Type ? @Localizer["Shared.Deals.Status.Won"] : @Localizer["Shared.Deals.Status.Open"])</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">@Localizer["Shared.Common.Edit"]</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">@Localizer["Shared.Common.Details"]</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@Localizer["Shared.Common.Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>