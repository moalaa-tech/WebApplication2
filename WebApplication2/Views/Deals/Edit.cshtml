@using CRM.WebApp.DTOs.Deal
@model UpdateDealDto

<h1>Edit Deal</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Similar fields as Create view -->

            <div class="form-group">
                <label class="control-label">Existing Files</label>
                @if (Model.NewFiles != null && Model.NewFiles.Any())
                {
                    <div class="file-list">
                        @* @foreach (var file in Model.NewFiles)
                        {
                            <div class="file-item">
                                <input type="checkbox" name="FilesToDelete" value="@file.Id" />
                                <a href="/deal-files/@file.FileName" target="_blank">@file.FileName</a>
                            </div>
                        } *@
                    </div>
                }
                else
                {
                    <p>No files attached</p>
                }
            </div>

            <div class="form-group">
                <label class="control-label">Add New Files</label>
                <input type="file" name="NewFiles" multiple class="form-control-file" />
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>