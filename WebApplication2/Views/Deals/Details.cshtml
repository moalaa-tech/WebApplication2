@using CRM.WebApp.DTOs.Deal
@model DealDto

<h1>Deal Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Account</dt>
        <dd class="col-sm-9">@Model.AccountName</dd>

        <dt class="col-sm-3">Deal Owner</dt>
        <dd class="col-sm-9">@Model.DealOwner</dd>

        <dt class="col-sm-3">Opportunity</dt>
        <dd class="col-sm-9">@Model.OpportunityName</dd>

        <dt class="col-sm-3">Contact</dt>
        <dd class="col-sm-9">@Model.ContactName</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

        <dt class="col-sm-3">Final Value</dt>
        <dd class="col-sm-9">@Model.FinalValue.ToString("C")</dd>

        <dt class="col-sm-3">Closing Date</dt>
        <dd class="col-sm-9">@Model.ClosingDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.Type ? "Won" : "Open")</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Files</dt>
        <dd class="col-sm-9">
            @if (Model.Files.Any())
            {
                <ul>
                    @foreach (var file in Model.Files)
                    {
                        <li><a href="/deal-files/@file.FilePath" target="_blank">@file.FileName</a></li>
                    }
                </ul>
            }
            else
            {
                <span>No files attached</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>