@model CRM.WebApp.ViewModels.Banking.CreateReconciliationViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer Localizer

<h2>@Localizer["Shared.Reconciliations.Create.Title"]</h2>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="BankAccountId" class="form-label"></label>
        <input asp-for="BankAccountId" class="form-control" />
        <span asp-validation-for="BankAccountId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StatementDate" class="form-label"></label>
        <input asp-for="StatementDate" class="form-control" type="date" />
        <span asp-validation-for="StatementDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StatementBalance" class="form-label"></label>
        <input asp-for="StatementBalance" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="StatementBalance" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AdjustedBookBalance" class="form-label"></label>
        <input asp-for="AdjustedBookBalance" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="AdjustedBookBalance" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsReconciled" class="form-check-input" type="checkbox" />
        <label asp-for="IsReconciled" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["Shared.Common.Create"]</button>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["Shared.Common.BackToList"]</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}