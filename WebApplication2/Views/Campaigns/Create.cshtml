@using CRM.WebApp.ViewModels.MarketingAutomation
@model CampaignCreateViewModel

<h2>@Localizer["Campaigns.Create.Title", "Create New Campaign"]</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Name" class="control-label">@Localizer["Campaigns.Field.Name", "Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label">@Localizer["Campaigns.Field.Description", "Description"]</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="StartDate" class="control-label">@Localizer["Campaigns.Field.StartDate", "Start Date"]</label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="EndDate" class="control-label">@Localizer["Campaigns.Field.EndDate", "End Date"]</label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Budget" class="control-label">@Localizer["Campaigns.Field.Budget", "Budget"]</label>
        <input asp-for="Budget" class="form-control" />
        <span asp-validation-for="Budget" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EmailTemplateId" class="control-label">@Localizer["Campaigns.Field.EmailTemplate", "Email Template"]</label>
        <select asp-for="EmailTemplateId" asp-items="Model.EmailTemplateOptions" class="form-control">
            <option value="">@Localizer["Campaigns.Select.EmailTemplate", "-- Select Email Template --"]</option>
        </select>
    </div>

    <div class="form-group">
        <input type="submit" value="@Localizer["Common.Create", "Create"]" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Common.Cancel", "Cancel"]</a>
    </div>
</form>