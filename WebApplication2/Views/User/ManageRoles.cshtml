
@model CRM.WebApp.ViewModels.User.ManageUserRolesViewModel

@{ 
    ViewData["Title"] = "Manage Roles";
}

<h1>Manage Roles for @Model.UserName</h1>

<form asp-action="ManageRoles">
    <input type="hidden" asp-for="UserId" />
    <div class="form-group">
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check">
                <input type="hidden" asp-for="@Model.Roles[i].RoleName" />
                <input type="checkbox" asp-for="@Model.Roles[i].Selected" class="form-check-input" />
                <label class="form-check-label">@Model.Roles[i].RoleName</label>
            </div>
        }
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
