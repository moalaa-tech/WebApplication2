@model IEnumerable<CRM.WebApp.DTOs.HumanResources.CountryDto>
@{
    ViewData["Title"] = "Countries";
}

<h1>Countries</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New Country</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Name (AR)</th>
            <th>ISO2</th>
            <th>ISO3</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var country in Model)
        {
            <tr>
                <td>@country.Name</td>
                <td>@country.NameAr</td>
                <td>@country.ISO2</td>
                <td>@country.ISO3</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@country.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@country.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
