@model IEnumerable<CRM.WebApp.DTOs.HumanResources.CountryDto>
@{
    ViewData["Title"] = @Localizer["Shared.Country.Title"];
}

<h1>@Localizer["Shared.Country.Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Shared.Country.NewCountry"]</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Localizer["Shared.Country.Name"]</th>
            <th>@Localizer["Shared.Country.NameAR"]</th>
            <th>@Localizer["Shared.Country.ISO2"]</th>
            <th>@Localizer["Shared.Country.ISO3"]</th>
            <th>@Localizer["Common.Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var country in Model)
        {
            <tr>
                <td>@country.Name</td>
                <td>@country.NameAr</td>
                <td>@country.ISO2</td>
                <td>@country.ISO3</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@country.Id" class="btn btn-sm btn-warning">@Localizer["Common.Edit", "Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@country.Id" class="btn btn-sm btn-danger">@Localizer["Common.Delete", "Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>
