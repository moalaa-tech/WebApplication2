@using CRM.WebApp.ViewModels.InventoryManagement.Order
@model StatisticsViewModel
@{
    ViewData["Title"] = "Statistics";
}

<h1>@ViewData["Title"]</h1>

<form method="post" asp-action="CalculateStatistics" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Employee</label>
        <select asp-for="EmployeeId" class="form-select">
            <option value="">Select Employee</option>
            @if (ViewBag.Employees != null)
            {
                @foreach (var employee in ViewBag.Employees as List<SelectListItem>)
                {
                    <option value="@employee.Value" selected="@employee.Selected">@employee.Text</option>
                }
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Date From</label>
        <input asp-for="DateFrom" type="date" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Date To</label>
        <input asp-for="DateTo" type="date" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-primary d-block w-100">Calculate</button>
    </div>
</form>

@if (Model?.Statistics != null)
{
    <div class="row">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <h3 class="text-primary">@Model.Statistics.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <h3 class="text-warning">@Model.Statistics.PendingOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Confirmed</h5>
                    <h3 class="text-info">@Model.Statistics.ConfirmedOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Paid</h5>
                    <h3 class="text-success">@Model.Statistics.PaidOrders</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Delivered</h5>
                    <h3 class="text-dark">@Model.Statistics.DeliveredOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Canceled</h5>
                    <h3 class="text-danger">@Model.Statistics.CanceledOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Amount</h5>
                    <h3 class="text-success">@Model.Statistics.TotalAmount.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>
}