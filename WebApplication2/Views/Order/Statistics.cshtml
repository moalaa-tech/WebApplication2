@using CRM.WebApp.ViewModels.InventoryManagement.Order
@model StatisticsViewModel
@{
    ViewData["Title"] = Localizer["Shared.Order.Statistics.Title", "Statistics"];
}

<h1>@Localizer["Shared.Order.Statistics.Title", "Statistics"]</h1>

<form method="post" asp-action="Statistics" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">@Localizer["Shared.Order.Statistics.Employee", "Employee"]</label>
        <select asp-for="EmployeeId" class="form-select">
            <option value="">@Localizer["Shared.Order.Statistics.SelectEmployee", "Select Employee"]</option>
            @if (ViewBag.Employees != null)
            {
                @foreach (var employee in ViewBag.Employees as List<SelectListItem>)
                {
                    <option value="@employee.Value" selected="@employee.Selected">@employee.Text</option>
                }
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["Shared.Order.Statistics.DateFrom", "Date From"]</label>
        <input asp-for="DateFrom" type="date" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["Shared.Order.Statistics.DateTo", "Date To"]</label>
        <input asp-for="DateTo" type="date" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-primary d-block w-100">@Localizer["Shared.Order.Statistics.Calculate", "Calculate"]</button>
    </div>
</form>

@if (Model?.Statistics != null)
{
    <div class="row">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.TotalOrders", "Total Orders"]</h5>
                    <h3 class="text-primary">@Model.Statistics.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.Pending", "Pending"]</h5>
                    <h3 class="text-warning">@Model.Statistics.PendingOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.Confirmed", "Confirmed"]</h5>
                    <h3 class="text-info">@Model.Statistics.ConfirmedOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.Paid", "Paid"]</h5>
                    <h3 class="text-success">@Model.Statistics.PaidOrders</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.Delivered", "Delivered"]</h5>
                    <h3 class="text-dark">@Model.Statistics.DeliveredOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.Canceled", "Canceled"]</h5>
                    <h3 class="text-danger">@Model.Statistics.CanceledOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Shared.Order.Statistics.TotalAmount", "Total Amount"]</h5>
                    <h3 class="text-success">@Model.Statistics.TotalAmount.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    if (Model.Statistics.OrdersPerMonth != null && Model.Statistics.OrdersPerMonth.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">@Localizer["Shared.Order.Statistics.OrdersPerMonth", "Orders Per Month"]</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>@Localizer["Shared.Order.Statistics.Year", "Year"]</th>
                                    <th>@Localizer["Shared.Order.Statistics.Month", "Month"]</th>
                                    <th>@Localizer["Shared.Order.Statistics.OrderCount", "Order Count"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var monthData in Model.Statistics.OrdersPerMonth)
                                {
                                    <tr>
                                        <td>@monthData.Year</td>
                                        <td>@Localizer[$"common.Months.{monthData.MonthName}", monthData.MonthName]</td>
                                        <td>@monthData.OrderCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}