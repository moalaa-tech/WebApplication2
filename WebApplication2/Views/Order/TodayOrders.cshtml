@Model.Result.TotalCount
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Localizer["Shared.Order.Field.OrderNumber", "Order Number"]
            </th>
            <th>
                @Localizer["Shared.Order.Field.Status", "Order Status"]
            </th>
            <th>
                @Localizer["Shared.Order.Field.TotalAmount", "Total Amount"]
            </th>

            <th>
                @Localizer["Shared.Order.Field.CustomerName", "Customer Name"]
            </th>

            <th>
                @Localizer["Shared.Order.Field.Address"]
            </th>

            <th>@Localizer["Shared.Order.Field.Area"]</th>
            <th>@Localizer["Common.Actions", "Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Result)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>

                <td>
                    <select class="form-select form-select-sm" name="Status_@item.Id" id="Status_@item.Id" onchange="updateStatus(@item.Id, this.value)">
                        @foreach (var status in Enum.GetValues(typeof(InvoiceStatus)))
                        {
                            <option value="@((int)status)" selected="@(item.Status == (InvoiceStatus)status)">
                                @Localizer[$"common.{(InvoiceStatus)status}"]
                            </option>
                        }
                    </select>
                </td>



                <td>
                    @Html.DisplayFor(modelItem => item.TotalAmount)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Address)
                </td>


                <td>
                    <select class="form-select form-select-sm" name="Area_@item.Id" id="Area_@item.Id" onchange="updateArea(@item.Id, this.value)">
                        <option value="">@Localizer["Common.SelectArea", "Select Area"]</option>
                        @if (ViewBag.Cities != null)
                        {
                            @foreach (var area in ViewBag.Cities as List<SelectListItem>)
                            {
                                <option value="@area.Value" selected="@(area.Value == item.StatesId.ToString())">@area.Text</option>
                            }
                        }
                    </select>
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Common.Edit", "Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">@Localizer["Common.Details", "Details"]</a> |
@*                     <a asp-action="ExportPdf" asp-route-id="@item.Id">@Localizer["Shared.Order.Index.Export", "Export"]</a>
 *@
                </td>
            </tr>
        }
    </tbody>
</table>



@Localizer["Common.Page"] @Model.PageIndex @Localizer["Common.Of"] @Model.Result.TotalPages


<nav aria-label="Page navigation example">
    <ul class="pagination">

        @{
            int startPage = Math.Max(1, Model.PageIndex - 2);
            int endPage = Math.Min(Model.Result.TotalPages, Model.PageIndex + 2);

            if (Model.Result.TotalPages > 5)
            {
                if (endPage - startPage < 4)
                {
                    startPage = Math.Max(1, endPage - 4);
                }
                if (endPage - startPage < 4)
                {
                    endPage = Math.Min(Model.Result.TotalPages, startPage + 4);
                }
            }
        }


        @for (var i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link"
                   asp-action="TodayOrders"
                   asp-route-pageIndex="@i">
                    @i
                </a>
            </li>
        }


        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
            <a class="page-link"
               asp-action="TodayOrders"
               asp-route-pageIndex="@(Model.PageIndex + 1)"
               aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>

    </ul>
</nav>
<div class="text-center mt-3">
    <span class="text-muted">
        Showing Page @Model.PageIndex of @Model.Result.TotalPages
    </span>
</div>

@functions {
    string GetStatusColor(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Pending => "secondary",
            InvoiceStatus.Confirmed => "info",
            InvoiceStatus.PendingPayment => "warning",
            InvoiceStatus.Paid => "success",
            InvoiceStatus.PaymentFailed => "danger",
            InvoiceStatus.Processing => "primary",
            InvoiceStatus.WaitingForPickup => "light",
            InvoiceStatus.InDelivery => "dark",
            InvoiceStatus.Delivered => "success",
            InvoiceStatus.Canceled => "secondary",
            InvoiceStatus.ReturningFromDelivery => "warning",
            InvoiceStatus.RequestRefund => "info",
            InvoiceStatus.RefundInProgress => "light",
            InvoiceStatus.Refunded => "success",
            _ => "light"
        };
    }
}


@section Scripts {

    <script>

        function exportPdf(){

            var xhr = new XMLHttpRequest();
            xhr.open("GET", "https://api.example.com/data", true);
            xhr.onreadystatechange = function () {
              if (xhr.readyState === 4 && xhr.status === 200) {
                var response = JSON.parse(xhr.responseText);
                console.log(response);
              }
            };
            xhr.send();
        }

        function updateArea(orderId, areaId) {
            debugger;
            fetch('/Order/UpdateArea', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="AntiforgeryFieldname"]').value
                },
                body: JSON.stringify({ orderId: orderId, areaId: areaId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Area updated successfully');
                }
            })
            .catch(error => console.error('Error updating area:', error));
        }

        function updateStatus(orderId, status) {
            var token = document.querySelector('input[name="AntiforgeryFieldname"]');
            if (!token) return;

            fetch('/Order/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token.value
                },
                body: JSON.stringify({ orderId: orderId, status: status })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Status updated successfully');
                }
            })
            .catch(error => console.error('Error updating status:', error));
        }

    </script>
}
