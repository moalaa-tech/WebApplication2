@model CRM.WebApp.DTOs.Order.CreateOrderDto

@{
    ViewData["Title"] = @Localizer["Shared.Order.Create.Header", "Product"];
    var products = ViewBag.products.Items;
}

<h1>Create Order</h1>

<h4>@Localizer["Shared.Order.Create.Header", "Product"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CustomerId" class="control-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.customer" class="form-control">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <hr />
            <h4>Order Items</h4>

            <table class="table table-bordered" id="orderItemsTable">
                <thead>
                    <tr>
                        <th>@Localizer["Shared.Order.Field.ProductName", "Product"]</th>
                        <th>@Localizer["Shared.Order.Field.ItemsCount", "Quantity"]</th>
                        <th>@Localizer["Shared.Order.Field.TotalAmount", "Unit Price"]</th>
                        <th>@Localizer["Shared.Order.Field.LineTotal", "Line Total"]</th>
                        <th>@Localizer["Shared.Common.Action", "Action"]</th>
                    </tr>
                </thead>
                <tbody id="orderItemsBody">
                    <tr>
                        <td>
                            <select name="Items[0].ProductId" class="form-control">
                                <option value="">--Select Product--</option>
                                @foreach (var p in products)
                                {
                                    <option value="@p.Id" data-price="@p.TotalCost">@p.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input name="Items[0].Quantity" type="number" class="form-control qty-input" value="1" min="1" />
                        </td>
                        <td>
                            <input type="text" class="form-control price-input" readonly />
                        </td>
                        <td>
                            <input type="text" class="form-control line-total" readonly />
                        </td>


                        <td>
                            <button type="button" class="btn btn-danger btn-sm remove-item">@Localizer["Common.Remove", "Action"]</button>
                        </td>
                    </tr>
                </tbody>
            </table>

            <button type="button" class="btn btn-secondary" id="addItem">+ Add Product</button>

            <div class="mt-3 text-end">
                <label><strong>@Localizer["Shared.Order.Field.TotalCost", "Product"]:</strong></label>
                <input asp-for="TotalAmount" id="grandTotal" class="form-control d-inline-block w-auto" readonly />
            </div>


            <div class="form-group">
                <input type="submit" value="@Localizer["common.Submit"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>
        let itemIndex = 1;

        // Add new product row
        document.getElementById('addItem').addEventListener('click', function () {
            let tbody = document.getElementById('orderItemsBody');
            let firstRow = tbody.querySelector('tr');
            let newRow = firstRow.cloneNode(true);

            // Update name indexes
            newRow.querySelectorAll('select, input').forEach(el => {
                if (el.name) el.name = el.name.replace(/\[\d+\]/, `[${itemIndex}]`);
                if (el.classList.contains('price-input') || el.classList.contains('line-total'))
                    el.value = '';
                if (el.classList.contains('qty-input'))
                    el.value = 1;
            });

            tbody.appendChild(newRow);
            itemIndex++;
        });

        // Delegate event for remove buttons
        document.addEventListener('click', function (e) {
            debugger;
            if (e.target.classList.contains('remove-item')) {
                e.target.closest('tr').remove();
                calculateGrandTotal();
            }
        });

        // Price & total calculation
        document.addEventListener('change', function (e) {
            debugger;
            if (e.target.classList.contains('product-select') || e.target.classList.contains('qty-input')) {
                console.log(e.target);

                const row = e.target.closest('tr');
                                console.log(row);

                const productSelect = row.querySelector('.product-select');
                const priceInput = row.querySelector('.price-input');
                const qtyInput = row.querySelector('.qty-input');
                const lineTotalInput = row.querySelector('.line-total');
                console.log(productSelect);
                const price = parseFloat(productSelect.selectedOptions[0].dataset.price || 0);
                const qty = parseInt(qtyInput.value || 0);
                const lineTotal = price * qty;

                priceInput.value = price.toFixed(2);
                lineTotalInput.value = lineTotal.toFixed(2);

                calculateGrandTotal();
            }
        });

        // Calculate Grand Total
        function calculateGrandTotal() {
            debugger;
            let total = 0;
            document.querySelectorAll('.line-total').forEach(input => {
                total += parseFloat(input.value || 0);
            });
            document.getElementById('grandTotal').value = total.toFixed(2);
        }
    </script>

}