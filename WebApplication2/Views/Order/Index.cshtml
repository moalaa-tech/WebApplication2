@using CRM.Domain.Enums
@using CRM.WebApp.Paging
@using CRM.WebApp.ViewModels.InventoryManagement.Order
@model OrderViewModel
@{
   // ViewData["Title"] = Localizer["Shared.Order.Index.Title", "Orders"];
    //var States = ViewBag.States as (List<SelectListItem>);
}

<h1>@Localizer["Shared.Order.Index.Title", "Orders"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Shared.Order.Index.NewOrder", "New Order"]</a>
    <a asp-action="Upload" class="btn btn-primary">@Localizer["Shared.Order.Index.Upload", "Upload"]</a>
</p>


<form method="get" asp-action="Index" class="row g-3 mb-4">

    <!-- Invoice Number -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.InvoiceNumber"]</label>
        <input asp-for="InvoiceNumber" type="number" value="@Model.InvoiceNumber" class="form-control" />
    </div>

    <!-- Invoice Status -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.Status"]</label>
        <select asp-for="Status" name="Status" class="form-select">
            <option value="">@Localizer["common.All"]</option>
            @foreach (var status in Enum.GetValues(typeof(InvoiceStatus)))
            {
                <option value="@status" selected="@(Model.Status.HasValue && Model.Status.Value == (InvoiceStatus)status)">
                    @Localizer[$"common.{status}"]
                </option>
            }
        </select>
    </div>

    <!-- Employee -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.Employee"]</label>
        <select asp-for="EmployeeId" asp-items="@ViewBag.Users" class="form-control"></select>
    </div>

    <!-- Date From -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.DateFrom"]</label>
        <input type="date" asp-for="DateFrom" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Date To -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.DateTo"]</label>
        <input type="date" asp-for="DateTo" class="form-control" value="@Model?.DateTo?.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Product -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.Product"]</label>
        <select asp-for="ProductId" asp-items="@ViewBag.Products" class="form-control"></select>

    </div>


    <!-- State -->
    <div class="col-md-2">
        <label class="form-label">@Localizer["Shared.Order.Filter.State"]</label>
        <select asp-for="StateId" asp-items="@ViewBag.States" class="form-select">
            @*<option value="">@Localizer["common.All"]</option> *@        
        </select>
    </div>


    <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary mt-2">@Localizer["Common.Search", "Search"]</button>
    </div>
</form>


@Model.Result.TotalCount
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Localizer["Shared.Order.Field.OrderNumber", "Order Number"]
            </th>
            <th>
                @Localizer["Shared.Order.Field.Status", "Order Status"]
            </th>
            <th>
                @Localizer["Shared.Order.Field.TotalAmount", "Total Amount"]
            </th>

            <th>
                @Localizer["Shared.Order.Field.CustomerName", "Customer Name"]
            </th>

            <th>
                @Localizer["Shared.Order.Field.Address"]
            </th>

            <th>@Localizer["Common.State", "State"]</th>
            <th>@Localizer["Common.Area", "Area"]</th>
            <th>@Localizer["Common.Actions", "Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Result)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>

                <td>
                    <select class="form-select form-select-sm" name="Status_@item.Id" id="Status_@item.Id" onchange="updateStatus(@item.Id, this.value)">
                        @foreach (var status in Enum.GetValues(typeof(InvoiceStatus)))
                        {
                            <option value="@((int)status)" selected="@(item.Status == (InvoiceStatus)status)">
                                @Localizer[$"common.{(InvoiceStatus)status}"]
                            </option>
                        }
                    </select>
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.TotalAmount)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Address)
                </td>

                <td>
                    <select class="form-select form-select-sm state-dropdown" name="State_@item.Id" id="State_@item.Id" onchange="loadCities(@item.Id, this.value)" data-order-id="@item.Id">
                        <option value="">@Localizer["Common.SelectState", "Select State"]</option>
                        @if (ViewBag.AllStates != null)
                        {
                            @foreach (var state in ViewBag.AllStates as List<SelectListItem>)
                            {
                                <option value="@state.Value">@state.Text</option>
                            }
                        }
                    </select>
                </td>

                <td>
                    <select class="form-select form-select-sm city-dropdown" name="Area_@item.Id" id="Area_@item.Id" onchange="updateArea(@item.Id, this.value)" disabled>
                        <option value="">@Localizer["Common.SelectArea", "Select Area"]</option>
                    </select>
                    <input type="hidden" name="SelectedStateId_@item.Id" id="SelectedStateId_@item.Id" value="" />
                </td>

                <td>
                    <div class="dropdown position-static">
                        <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil me-2"></i>
                                    <span>@Localizer["Common.Edit", "Edit"]</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye me-2"></i>
                                    <span>@Localizer["Common.Details", "Details"]</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash me-2"></i>
                                    <span>@Localizer["Common.Delete", "Delete"]</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-action="ExportPdf" asp-route-id="@item.Id">
                                    <i class="bi bi-file-pdf me-2"></i>
                                    <span>@Localizer["Shared.Order.Index.Export", "Export"]</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>



@Localizer["Common.Page"] @Model.PageIndex @Localizer["Common.Of"] @Model.Result.TotalPages


<nav aria-label="Page navigation example">
    <ul class="pagination">

        @{
            int startPage = Math.Max(1, Model.PageIndex - 2);
            int endPage = Math.Min(Model.Result.TotalPages, Model.PageIndex + 2);

            if (Model.Result.TotalPages > 5)
            {
                if (endPage - startPage < 4)
                {
                    startPage = Math.Max(1, endPage - 4);
                }
                if (endPage - startPage < 4)
                {
                    endPage = Math.Min(Model.Result.TotalPages, startPage + 4);
                }
            }
        }


        @for (var i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageIndex="@i">
                    @i
                </a>
            </li>
        }


        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
            <a class="page-link"
               asp-action="Index"
               asp-route-pageIndex="@(Model.PageIndex + 1)"
               aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>

    </ul>
</nav>
<div class="text-center mt-3">
    <span class="text-muted">
        Showing Page @Model.PageIndex of @Model.Result.TotalPages
    </span>
</div>

@functions {
    string GetStatusColor(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Pending => "secondary",
            InvoiceStatus.Confirmed => "info",
            InvoiceStatus.PendingPayment => "warning",
            InvoiceStatus.Paid => "success",
            InvoiceStatus.PaymentFailed => "danger",
            InvoiceStatus.Processing => "primary",
            InvoiceStatus.WaitingForPickup => "light",
            InvoiceStatus.InDelivery => "dark",
            InvoiceStatus.Delivered => "success",
            InvoiceStatus.Canceled => "secondary",
            InvoiceStatus.ReturningFromDelivery => "warning",
            InvoiceStatus.RequestRefund => "info",
            InvoiceStatus.RefundInProgress => "light",
            InvoiceStatus.Refunded => "success",
            _ => "light"
        };
    }
}


@section Scripts {

    <script>
        // Store city data for each order
        const orderCityData = {};

        function exportPdf(){

            var xhr = new XMLHttpRequest();
            xhr.open("GET", "https://api.example.com/data", true);
            xhr.onreadystatechange = function () {
              if (xhr.readyState === 4 && xhr.status === 200) {
                var response = JSON.parse(xhr.responseText);
                console.log(response);
              }
            };
            xhr.send();
        }

        // Load cities for a specific state and populate the city dropdown
        function loadCities(orderId, stateId) {
            const cityDropdown = document.getElementById('Area_' + orderId);
            const stateDropdown = document.getElementById('State_' + orderId);

            // Clear existing options
            cityDropdown.innerHTML = '<option value="">@Localizer["Common.SelectArea", "Select Area"]</option>';

            if (!stateId) {
                cityDropdown.disabled = true;
                return;
            }

            // Fetch cities for the selected state
            fetch('/Order/GetCitiesByStateId?stateId=' + stateId)
                .then(response => response.json())
                .then(cities => {
                    // Store for this order
                    orderCityData[orderId] = cities;

                    // Populate city dropdown
                    cities.forEach(city => {
                        const option = document.createElement('option');
                        option.value = city.id;
                        option.textContent = city.nameAr || city.name;
                        cityDropdown.appendChild(option);
                    });

                    cityDropdown.disabled = false;

                    // Restore previously selected city if exists
                    const selectedCityId = document.getElementById('SelectedCityId_' + orderId)?.value;
                    if (selectedCityId) {
                        cityDropdown.value = selectedCityId;
                    }
                })
                .catch(error => {
                    console.error('Error loading cities:', error);
                    cityDropdown.disabled = true;
                });
        }

        function updateArea(orderId, areaId) {
            // Store the selected city ID for restoration after state changes
            let hiddenInput = document.getElementById('SelectedCityId_' + orderId);
            if (!hiddenInput) {
                hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.id = 'SelectedCityId_' + orderId;
                hiddenInput.name = 'SelectedCityId_' + orderId;
                document.body.appendChild(hiddenInput);
            }
            hiddenInput.value = areaId;

            fetch('/Order/UpdateArea', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="AntiforgeryFieldname"]').value
                },
                body: JSON.stringify({ orderId: orderId, areaId: areaId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Area updated successfully');
                }
            })
            .catch(error => console.error('Error updating area:', error));
        }

        function updateStatus(orderId, status) {
            var token = document.querySelector('input[name="AntiforgeryFieldname"]');
            if (!token) return;

            fetch('/Order/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token.value
                },
                body: JSON.stringify({ orderId: orderId, status: status })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Status updated successfully');
                }
            })
            .catch(error => console.error('Error updating status:', error));
        }

        // Initialize: Load state and city for orders that already have a StatesId (city) assigned
        document.addEventListener('DOMContentLoaded', function() {
            @foreach (var item in Model.Result)
            {
                <text>
                (function() {
                    const orderId = @item.Id;
                    const statesId = @(item.StatesId ?? 0);
                    const cityStateId = @(item.CityId ?? 0);

                    const stateDropdown = document.getElementById('State_' + orderId);
                    const cityDropdown = document.getElementById('Area_' + orderId);

                    // Pre-select the state if CityStateId is available
                    if (cityStateId > 0 && stateDropdown) {
                        stateDropdown.value = cityStateId;
                    }

                    // If order has a city assigned, store it and load cities
                    if (statesId > 0) {
                        // Store the selected city ID
                        let hiddenInput = document.getElementById('SelectedCityId_' + orderId);
                        if (!hiddenInput) {
                            hiddenInput = document.createElement('input');
                            hiddenInput.type = 'hidden';
                            hiddenInput.id = 'SelectedCityId_' + orderId;
                            hiddenInput.name = 'SelectedCityId_' + orderId;
                            hiddenInput.value = statesId;
                            document.body.appendChild(hiddenInput);
                        } else {
                            hiddenInput.value = statesId;
                        }

                        // Load cities for the state and select the city
                        if (cityStateId > 0) {
                            loadCitiesAndSelect(orderId, cityStateId, statesId);
                        }
                    }
                })();
                </text>
            }
        });

        // Load cities for a state and select a specific city
        function loadCitiesAndSelect(orderId, stateId, cityIdToSelect) {
            const cityDropdown = document.getElementById('Area_' + orderId);

            fetch('/Order/GetCitiesByStateId?stateId=' + stateId)
                .then(response => response.json())
                .then(cities => {
                    cityDropdown.innerHTML = '<option value="">@Localizer["Common.SelectArea", "Select Area"]</option>';
                    cityDropdown.disabled = false;

                    cities.forEach(city => {
                        const option = document.createElement('option');
                        option.value = city.id;
                        option.textContent = city.nameAr || city.name;
                        cityDropdown.appendChild(option);
                    });

                    // Select the city
                    cityDropdown.value = cityIdToSelect;
                })
                .catch(error => {
                    console.error('Error loading cities:', error);
                    cityDropdown.disabled = true;
                });
        }
    </script>
}